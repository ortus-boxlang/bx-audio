/**
 * This is the module descriptor and entry point for your module in the runtime.
 * The unique name of the moduel is the name of the directory on the modules folder.
 * A BoxLang mapping will be created for you with the name of the module.
 *
 * A module can have the following folders that will be automatically registered:
 * + bifs - Custom BIFs that will be registered into the runtime
 * + interceptors - Custom interceptors that will be registered into the runtime via the configure() method
 * + libs - Custom java libraries that your module leverages
 * + tags - Custom tags that will be registered into the runtime
 *
 * Every module will have its own classloader that will be used to load the module libs and dependencies.
 */
class {

	property name="moduleRecord";
	property name="boxRuntime";
	property name="log";

	/**
	 * --------------------------------------------------------------------------
	 * Module Properties
	 * --------------------------------------------------------------------------
	 * Here is where you define the properties of your module that the module service
	 * will use to register and activate your module
	 */

	/**
	 * Your module version. Try to use semantic versioning
	 * @mandatory
	 */
	this.version = "@build.version@+@build.number@";

	/**
	 * The BoxLang mapping for your module.  All BoxLang modules are registered with an internal
	 * mapping prefix of : bxModules.{this.mapping}, /bxmodules/{this.mapping}. Ex: bxModules.test, /bxmodules/test
	 */
	this.mapping = "bxaudio";

	/**
	 * Who built the module
	 */
	this.author = "Luis Majano";

	/**
	 * The module description
	 */
	this.description = "Audio synthesis, mixing, analysis, text-to-speech and playback for BoxLang, with no native dependencies";

	/**
	 * The module web URL
	 */
	this.webURL = "https://www.ortussolutions.com";

	/**
	 * This boolean flag tells the module service to skip the module registration/activation process.
	 */
	this.enabled = true;

    /**
	 * The module dependencies that this module needs to be activated before this module is activated
	 */
	this.dependencies = [];

	/**
	 * --------------------------------------------------------------------------
	 * Module Methods
	 * --------------------------------------------------------------------------
	 */

	/**
	 * Called by the ModuleService on module registration
	 */
	function configure(){
		/**
		 * Every module has a settings configuration object
		 */
		settings = {
			// Where the speech engine, the voices and FFmpeg are downloaded to. Empty means the .bxaudio folder in the user's home.
			home : "",
			// May the module download the speech engine, a voice or FFmpeg when you first use something that needs it
			autoInstall : true,
			// Path to FFmpeg (the program, or its folder). Empty finds it in the BX_AUDIO_FFMPEG variable, the bx-audio home, then the PATH.
			ffmpeg : "",
			// AI tools offered to the BoxLang AI module (bx-ai) when it is installed
			ai : {
				// Register the audio tools in the bx-ai tool registry. Registering only makes them available, an agent still has to name them.
				enabled : true,
				// Folders the tools may read from and write to. Empty means the system temp folder and the working directory.
				allowedPaths : [],
				// Where results go when the agent names no output path. Empty means a bx-audio-ai folder in the system temp folder.
				outputDir : ""
			}
		};

		/**
		 * Every module can have a list of object mappings
		 * that can be created by boxLang.  This is a great way
		 * to create objects that can be used by the module
		 * or other modules.
		 * The mappings will be created in the following format:
		 * bxModules.{this.mapping}.{mappingName}
		 * Ex: bxModules.test.MyObject => bxModules.test.models.MyObject
		 */
		objectMappings = {
			// { name="MyObject", class="models.utilities.MyObject" }
		}

		/**
		 * DataSources can be defined by a module and they will be registered
		 * for you in the runtime
		 */
		datasources = {
			// { name="MyDSN", class="coldbox.system.datasources.ColdBoxDataSource", properties={dsn="mydsn"} }
		};

		/**
		 * The module interceptors to register into the runtime
		 */
		interceptors = [
			// { class="path.to.Interceptor", properties={} }
		];

		/**
		 * A list of custom interception points to register into the runtime
		 */
		customInterceptionPoints = [];
	}

	/**
	 * Called by the ModuleService on module activation
	 */
	function onLoad(){
		registerAiTools();
	}

	/**
	 * Called by the ModuleService on module deactivation
	 */
	function onUnload(){
		// Take the audio tools out of the bx-ai registry, so a reload does not leave tools that point at an unloaded module
		unregisterAiTools();

		// Close the mixers that are still open and the speech engine, so a reload starts clean
		try {
			createObject( "java", "ortus.boxlang.modules.audio.util.Lifecycle" ).shutdown();
		} catch( any e ){
			// nothing was started, or the classes are already gone
		}
	}

	/**
	 * --------------------------------------------------------------------------
	 * Module Events
	 * --------------------------------------------------------------------------
	 * You can listen to any runtime events by creating the methods
	 * that match the approved runtime interception points
	 */

	/**
	 * bx-ai may be activated after this module, so try again once every module is active. Registering twice is harmless.
	 */
	function afterModuleActivations(){
		registerAiTools();
	}

	/**
	 * Offer the audio tools to bx-ai: when the module is installed, its global tool registry (the aiToolRegistry() function) gets every
	 * @AITool method of the AudioTools class under the module name bxaudio, for example audioTrim@bxaudio.
	 *
	 * Without bx-ai, or with the ai.enabled setting off, this does nothing. Safe to call again: tools that are already there are left alone.
	 *
	 * @return True when the tools are in the registry
	 */
	function registerAiTools(){
		var aiSettings = moduleRecord.settings.ai ?: {};
		if ( !( aiSettings.enabled ?: true ) ) {
			return false;
		}

		if ( !hasAiToolRegistry() ) {
			return false;
		}
		var registry = aiToolRegistry();

		try {
			if ( !registry.has( "audioInfo@bxaudio" ) ) {
				registry.scanClass( new bxModules.bxaudio.models.tools.AudioTools( aiSettings ), "bxaudio" );
			}
			return true;
		} catch ( any e ) {
			// A problem with the optional AI tools must never keep the audio module from loading
			writeLog( text = "bx-audio could not register its AI tools: #e.message#", type = "error", log = "ai" );
			return false;
		}
	}

	/**
	 * Take the audio tools out of the bx-ai registry
	 */
	function unregisterAiTools(){
		if ( hasAiToolRegistry() ) {
			aiToolRegistry().unregisterByModule( "bxaudio" );
		}
	}

	/**
	 * Is bx-ai installed and active: it is when its aiToolRegistry() function exists. This asks the runtime's function service directly,
	 * because getFunctionList() keeps the list from its first call and would not see a module that activates later.
	 */
	private boolean function hasAiToolRegistry(){
		return boxRuntime.getFunctionService().hasGlobalFunction( "aiToolRegistry" );
	}

	/**
	 * Entry point for the command line: `boxlang module:bxaudio <command>`, or `bx-audio <command>` when the module was installed with
	 * install-bx-module, which creates that wrapper from the `executable` setting in box.json.
	 *
	 * @args The arguments after the module name
	 */
	function main( array args = [] ){
		try {
			new bxModules.bxaudio.cli.Cli( moduleRecord.path.toString() ).run( args );
		} catch( any e ){
			// A mistake in the command line, a missing file or a failed download is not a crash: print the message and set the exit code.
			// Set BX_AUDIO_DEBUG=1 to get the full stack trace instead.
			if( ( server.system.environment.BX_AUDIO_DEBUG ?: "" ) == "1" ){
				rethrow;
			}
			systemOutput( "bx-audio: " & e.message, true, true );
			cliExit( 1 );
		}
	}

}

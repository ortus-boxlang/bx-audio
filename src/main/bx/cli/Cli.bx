/**
 * The bx-audio command line. Run it with `bx-audio <command>` once the module is installed with install-bx-module, or with
 * `boxlang module:bxaudio <command>`.
 *
 * Every command is a method named `cmd<Name>` taking the parsed positionals and options, and returning nothing. Output goes through
 * out() so tests can read it, and failures are thrown as exceptions with a message meant for the person at the terminal.
 */
class {

	/**
	 * The module folder, where the examples live
	 */
	property name="root" type="string";

	/**
	 * Everything the CLI printed, for tests
	 */
	property name="output" type="string" default="";

	/**
	 * Command names and one line of help each, in the order help lists them
	 */
	static {
		commands = [
			{ name : "info", usage : "info <file>", help : "Show the format, length and level of a WAV or MP3 file" },
			{ name : "convert", usage : "convert <in> <out> [--bitrate=N] [--bitDepth=16] [--sampleRate=N] [--channels=1|2]", help : "Convert between WAV and MP3, and change the sample rate or channels" },
			{ name : "normalize", usage : "normalize <in> <out> [--targetDb=-1]", help : "Scale the peak of a file to a level in decibels" },
			{ name : "trim", usage : "trim <in> <out> [--start=0] [--end=SECONDS]", help : "Cut a section out of a file" },
			{ name : "loudness", usage : "loudness <file>", help : "Measure the loudness in LUFS (EBU R128), the loudness range and the true peak" },
			{ name : "master", usage : "master <in> <out> [--target=streaming|podcast|broadcast|-14] [--truePeakDb=-1] [--glue]", help : "Reach a loudness target with a true-peak ceiling, ready to publish" },
			{ name : "stretch", usage : "stretch <in> <out> --rate=1.1 | --seconds=30", help : "Change the speed or fit the length, keeping the pitch" },
			{ name : "pitch", usage : "pitch <in> <out> --semitones=2", help : "Change the pitch, keeping the length" },
			{ name : "bpm", usage : "bpm <file> [--beats]", help : "Detect the tempo, and with --beats list where the beats fall" },
			{ name : "silence", usage : "silence <file> [--thresholdDb=-50] [--min=0.3] [--trim=OUT]", help : "List the silent stretches, or write a copy with the silence cut off both ends" },
			{ name : "waveform", usage : "waveform <file> [--width=60] [--unicode]", help : "Draw the loudness of a file on one line, with block characters if you add --unicode" },
			{ name : "speak", usage : "speak <text> --voice=NAME [--out=FILE] [--file=TEXTFILE] [--speed=1] [--captions=FILE.srt|.vtt] [--no-install]", help : "Say a text with an open license voice, installing the engine and the voice the first time",
				details : [
					"  --voice=NAME         A voice id or short name (see `bx-audio voices`)",
					"  --out=FILE           Where to write the audio: .wav, .mp3, .flac, or .ogg/.opus/.m4a with FFmpeg (default speech.wav)",
					"  --file=TEXTFILE      Read the text from a file instead of the command line",
					"  --speed=1            1 is the voice's own pace, 1.2 faster, 0.85 slower (0.25 to 4)",
					"  --captions=FILE      Also write captions timed to the voice: .srt or .vtt",
					"  --offset=0           Seconds added to every caption time",
					"  --max-chars=80       Longest caption line",
					"  --by-clause          Speak and time clause by clause (at commas), for more natural pauses and shorter captions",
					"  --sentence-pause=0.35  --clause-pause=0.15  --paragraph-pause=0.8   Seconds of quiet between the pieces",
					"  --no-install         Fail instead of downloading the engine or the voice",
					"",
					"Giving captions, a pause or --by-clause speaks the text piece by piece. Without them the voice phrases the whole text itself."
				] },
			{ name : "voices", usage : "voices [voice] [--lang=en_US] [--installed|--downloadable|--excluded|--all] [--license=ID]", help : "List voices with their licenses, what is installed, and why some are not offered",
				details : [
					"Without options it lists the voices you can use. Each row says whether it is installed or still to download.",
					"  <voice>         Full details of one voice: license, what the license asks, size, training data, where it is stored",
					"  --installed     Only voices on disk",
					"  --downloadable  Only offered voices you have not downloaded yet",
					"  --excluded      Voices that are NOT offered, each with the reason (license, GPL dictionary, several speakers, language)",
					"  --all           Offered and excluded together",
					"  --lang=en_US    One language (--lang=all is the default)",
					"  --license=ID    One license, for example CC0-1.0 or Apache-2.0",
					"",
					"See `bx-audio licenses` for what each license asks of you."
				] },
			{ name : "licenses", usage : "licenses", help : "Show the voice licenses and what each one asks of you" },
			{ name : "install", usage : "install <voice|engine> [...]", help : "Download a voice, or the speech engine every voice needs" },
			{ name : "remove", usage : "remove <voice|engine> [...]", help : "Delete a downloaded voice, or the speech engine" },
			{ name : "where", usage : "where", help : "Show where bx-audio keeps its downloads, and how much space they take" },
			{ name : "clean", usage : "clean [engine|voices|ffmpeg|cache|all] [--yes]", help : "Delete downloaded files to free space, after asking" },
			{ name : "play", usage : "play <file> [--volume=1] [--output=speakers|null]", help : "Play a file through the speakers" },
			{ name : "loopify", usage : "loopify <in> <out> [--crossfade=0.25]", help : "Make a sound loop seamlessly by blending its end into its start" },
			{ name : "sprite", usage : "sprite <out> <file> <file> ... [--gap=0.1]", help : "Join sounds into one audio sprite with a Howler.js map next to it (named by file name)" },
			{ name : "ffmpeg", usage : "ffmpeg [status|install]", help : "Show whether FFmpeg is available (OGG, Opus, AAC and video need it), or download it" },
			{ name : "probe", usage : "probe <file>", help : "Describe any audio or video file: length, size, video and audio streams" },
			{ name : "mux", usage : "mux <video> <audio> <out> [--keep-original] [--offset=0]", help : "Put an audio file on a video, copying the picture without re-encoding" },
			{ name : "pieces", usage : "pieces", help : "List the example pieces of music you can render" },
			{ name : "render", usage : "render <piece> [--out=FILE] [--bars=N] [--bpm=N] ...", help : "Synthesize an example piece to a WAV or MP3 file" },
			{ name : "explorer", usage : "explorer [--port=8080]", help : "Start the web explorer on the BoxLang MiniServer" },
			{ name : "doctor", usage : "doctor", help : "Check that MP3, FFmpeg, audio output, the examples and the explorer will work here" },
			{ name : "version", usage : "version", help : "Show the module version" },
			{ name : "help", usage : "help [command]", help : "Show this help" }
		];
	}

	/**
	 * The commands with their usage, one line of help and, for some, longer details. The documentation generator reads this, so the command
	 * line and its reference cannot drift apart.
	 */
	public static function getCommands(){
		return static.commands;
	}

	function init( required string root ){
		variables.root = arguments.root;
		return this;
	}

	/**
	 * Run a command line
	 *
	 * @args The arguments after the program name, for example [ "info", "song.wav" ]
	 */
	function run( required array args ){
		var parsed = createObject( "java", "ortus.boxlang.runtime.cli.CLIUtil" ).parseArguments( arguments.args );
		var positionals = parsed.positionals;
		var options = parsed.options;
		if( !positionals.len() ){
			return cmdHelp( [], options );
		}
		var name = positionals.first().lcase();
		var rest = positionals.slice( 2 );
		if( name == "--help" || name == "-h" ){
			name = "help";
		}
		if( !static.commands.some( ( c ) => c.name == name ) ){
			throw( type = "bxaudio.cli", message = "Unknown command [#name#]. Run `bx-audio help` to see the commands." );
		}
		if( options.keyExists( "help" ) ){
			return cmdHelp( [ name ], options );
		}
		checkOptions( name, options );
		return invoke( this, "cmd" & name.ucFirst(), [ rest, options ] );
	}

	/**
	 * Refuse an option the command does not have, so a misspelled or renamed one is not silently ignored. The options of a command are the
	 * ones its usage and details mention. `render` passes its options on to the piece, which checks them itself.
	 */
	private function checkOptions( required string name, required struct options ){
		if( name == "render" ){
			return;
		}
		var command = static.commands.filter( ( c ) => c.name == name ).first();
		var text = command.usage & " " & ( command.keyExists( "details" ) ? command.details.toList( " " ) : "" );
		var known = {};
		reMatch( "--[!A-Za-z][A-Za-z0-9-]*", text ).each( ( o ) => {
			var key = o.reReplace( "^--!?", "" ).reReplace( "^no-", "" ).replace( "-", "", "all" ).lcase();
			known[ key ] = true;
		} );
		known[ "help" ] = true;
		for( var option in options.keyArray() ){
			if( !known.keyExists( option.replace( "-", "", "all" ).lcase() ) ){
				throw( type = "bxaudio.cli", message = "Unknown option --#option# for `#name#`. Run `bx-audio help #name#` to see its options." );
			}
		}
	}

	// ---------------------------------------------------------------------------------------------------------------------------
	// Commands
	// ---------------------------------------------------------------------------------------------------------------------------

	function cmdHelp( required array args, required struct options ){
		if( args.len() ){
			var found = static.commands.filter( ( c ) => c.name == args.first() );
			if( !found.len() ){
				throw( type = "bxaudio.cli", message = "Unknown command [#args.first()#]." );
			}
			out( "bx-audio " & found.first().usage );
			out( "  " & found.first().help );
			if( found.first().keyExists( "details" ) ){
				out( "" );
				found.first().details.each( ( line ) => out( line ) );
			}
			return;
		}
		out( "bx-audio: make, mix and convert audio from the command line" );
		out( "" );
		out( "Usage: bx-audio <command> [options]" );
		out( "" );
		static.commands.each( ( c ) => out( "  " & pad( c.name, 11 ) & c.help ) );
		out( "" );
		out( "Run `bx-audio help <command>` for the options of one command." );
	}

	function cmdVersion( required array args, required struct options ){
		out( "bx-audio " & createObject( "java", "java.lang.String" ).valueOf( getModuleInfo( "bxaudio" ).version ) );
	}

	function cmdInfo( required array args, required struct options ){
		var file = needFile( args, 1, "info <file>" );
		var info = audioInfo( file, true );
		var dbfs = ( v ) => v > 0 ? numberFormat( 20 * log10( v ), "0.0" ) & " dBFS" : "silence";
		out( file );
		out( "  format    " & ( [ "wav", "wave", "" ].contains( file.listLast( "." ).lcase() ) || !file.find( "." ) ? "WAV" : file.listLast( "." ).ucase() ) );
		out( "  channels  " & info.channels );
		out( "  rate      " & info.sampleRate & " Hz" );
		out( "  length    " & numberFormat( info.seconds, "0.000" ) & " s (" & info.frames & " frames)" );
		out( "  peak      " & numberFormat( info.peak, "0.000" ) & " (" & dbfs( info.peak ) & ")" );
		out( "  rms       " & numberFormat( info.rms, "0.0000" ) & " (" & dbfs( info.rms ) & ")" );
	}

	function cmdConvert( required array args, required struct options ){
		var source = needFile( args, 1, "convert <in> <out>" );
		var target = absolute( needArg( args, 2, "convert <in> <out>" ) );
		ensureFfmpeg( target );
		var audio = audioLoad( source );
		if( options.keyExists( "sampleRate" ) ){
			audio = audioResample( audio, int( options.sampleRate ) );
		}
		if( options.keyExists( "channels" ) ){
			audio = audioChannels( audio, int( options.channels ) );
		}
		var written = audioSave(
			audio = audio,
			path = target,
			bitDepth = int( options.bitDepth ?: 16 ),
			bitrate = int( options.bitrate ?: 0 )
		);
		out( "wrote " & written );
	}

	function cmdNormalize( required array args, required struct options ){
		var source = needFile( args, 1, "normalize <in> <out>" );
		var target = absolute( needArg( args, 2, "normalize <in> <out>" ) );
		var written = audioSave( audioNormalize( audioLoad( source ), options.targetDb ?: -1 ), target );
		out( "wrote " & written );
	}

	function cmdTrim( required array args, required struct options ){
		var source = needFile( args, 1, "trim <in> <out>" );
		var target = absolute( needArg( args, 2, "trim <in> <out>" ) );
		var audio = audioLoad( source );
		var written = audioSave( audioTrim( audio, options.start ?: 0, options.end ?: audio.getDurationSeconds() ), target );
		out( "wrote " & written );
	}

	function cmdFfmpeg( required array args, required struct options ){
		var action = args.len() ? args.first().lcase() : "status";
		if( action == "install" ){
			var info = audioFfmpegInstall( progressPrinter() );
			out( "installed FFmpeg " & info.version & " at " & info.path );
			return;
		}
		if( action != "status" ){
			throw( type = "bxaudio.cli", message = "Unknown action [#action#]. Usage: bx-audio ffmpeg [status|install]" );
		}
		var f = audioFfmpeg();
		if( f.available ){
			out( "FFmpeg " & f.version & " (" & f.source & ")" );
			out( "  program   " & f.path );
			out( "  encoders  " & f.encoders.toList( ", " ) );
		} else {
			out( "FFmpeg is not available." );
			out( f.installable ? "  Download it (" & numberFormat( f.downloadSizeMB, "0.0" ) & " MB into " & f.installDir & ") with: bx-audio ffmpeg install" : "  There is no download for " & f.platform & ", install FFmpeg so it is on the PATH." );
		}
		out( "  Needed for: OGG, Opus, AAC and M4A files, reading video files, mux, probe. WAV, MP3 and FLAC never need it." );
	}

	function cmdPlay( required array args, required struct options ){
		var file = needFile( args, 1, "play <file>" );
		var audio = audioLoad( file );
		out( "playing " & file & " (" & numberFormat( audio.getDurationSeconds(), "0.0" ) & " s)" );
		audioPlay( audio = audio, wait = true, volume = val( options.volume ?: 1 ), output = options.output ?: "speakers" );
	}

	function cmdLoopify( required array args, required struct options ){
		var source = needFile( args, 1, "loopify <in> <out>" );
		var target = absolute( needArg( args, 2, "loopify <in> <out>" ) );
		var looped = audioLoopify( audioLoad( source ), val( options.crossfade ?: 0.25 ) );
		out( "wrote " & audioSave( looped, target ) & " (" & numberFormat( looped.getDurationSeconds(), "0.00" ) & " s)" );
	}

	function cmdSprite( required array args, required struct options ){
		var target = absolute( needArg( args, 1, "sprite <out> <file> <file> ..." ) );
		if( args.len() < 2 ){
			throw( type = "bxaudio.cli", message = "Missing argument. Usage: bx-audio sprite <out> <file> <file> ..." );
		}
		var sounds = [:];
		args.slice( 2 ).each( ( f ) => {
			var path = absolute( f );
			if( !fileExists( path ) ){
				throw( type = "bxaudio.cli", message = "File not found: #path#" );
			}
			sounds[ path.listLast( "/\\" ).reReplace( "\.[^.]*$", "" ) ] = audioLoad( path );
		} );
		var result = audioSprite( sounds = sounds, gap = val( options.gap ?: 0.1 ), path = target );
		out( "wrote " & result.path & " and " & result.mapPath );
		result.sprites.each( ( name, s ) => out( "  " & pad( name, 16 ) & numberFormat( s.start, "0.00" ) & " s to " & numberFormat( s.end, "0.00" ) & " s" ) );
	}

	function cmdProbe( required array args, required struct options ){
		var file = needFile( args, 1, "probe <file>" );
		var info = videoInfo( file );
		out( file );
		out( "  format    " & info.format );
		out( "  length    " & numberFormat( info.seconds, "0.000" ) & " s" );
		out( "  size      " & numberFormat( info.sizeBytes / 1000000, "0.0" ) & " MB" );
		if( !isNull( info.video ) ){
			out( "  video     " & info.video.codec & " " & info.video.width & "x" & info.video.height & " at " & info.video.fps & " fps" );
		}
		if( !isNull( info.audio ) ){
			out( "  audio     " & info.audio.codec & " " & info.audio.channels & " ch " & info.audio.sampleRate & " Hz" );
		}
	}

	function cmdMux( required array args, required struct options ){
		var video = needFile( args, 1, "mux <video> <audio> <out>" );
		var sound = needFile( args, 2, "mux <video> <audio> <out>" );
		var target = absolute( needArg( args, 3, "mux <video> <audio> <out>" ) );
		var keep = options.keyExists( "keep-original" ) && options[ "keep-original" ] != false;
		out( "wrote " & audioMux( video = video, audio = audioLoad( sound ), output = target, keepOriginal = keep, offset = val( options.offset ?: 0 ) ) );
	}

	function cmdLoudness( required array args, required struct options ){
		var r = audioLoudness( audioLoad( needFile( args, 1, "loudness <file>" ) ) );
		out( "integrated     " & numberFormat( r.integrated, "0.0" ) & " LUFS" );
		out( "range          " & numberFormat( r.range, "0.0" ) & " LU" );
		out( "true peak      " & numberFormat( r.truePeakDb, "0.0" ) & " dBFS" );
		out( "sample peak    " & numberFormat( r.samplePeakDb, "0.0" ) & " dBFS" );
		out( "momentary max  " & numberFormat( r.momentaryMax, "0.0" ) & " LUFS" );
		out( "short-term max " & numberFormat( r.shortTermMax, "0.0" ) & " LUFS" );
		out( "Streaming services aim at -14 LUFS, podcasts -16, broadcast -23." );
	}

	function cmdMaster( required array args, required struct options ){
		var source = needFile( args, 1, "master <in> <out>" );
		var target = absolute( needArg( args, 2, "master <in> <out>" ) );
		var goal = options.target ?: "streaming";
		var mastered = audioMaster( audio = audioLoad( source ), target = isNumeric( goal ) ? val( goal ) : goal, truePeakDb = options.truePeakDb ?: -1, glue = options.keyExists( "glue" ) && options.glue != false );
		var r = audioLoudness( mastered );
		var written = audioSave( mastered, target );
		out( "wrote " & written & " (" & numberFormat( r.integrated, "0.0" ) & " LUFS, true peak " & numberFormat( r.truePeakDb, "0.0" ) & " dBFS)" );
	}

	function cmdStretch( required array args, required struct options ){
		var source = needFile( args, 1, "stretch <in> <out> --rate=N|--seconds=N" );
		var target = absolute( needArg( args, 2, "stretch <in> <out> --rate=N|--seconds=N" ) );
		var audio = audioLoad( source );
		if( options.keyExists( "seconds" ) ){
			audio = audioFitTo( audio, val( options.seconds ) );
		} else if( options.keyExists( "rate" ) ){
			audio = audioStretch( audio, val( options.rate ) );
		} else {
			throw( type = "bxaudio.cli", message = "Missing option. Usage: bx-audio stretch <in> <out> --rate=1.1 | --seconds=30" );
		}
		out( "wrote " & audioSave( audio, target ) & " (" & numberFormat( audio.getDurationSeconds(), "0.00" ) & " s)" );
	}

	function cmdPitch( required array args, required struct options ){
		var source = needFile( args, 1, "pitch <in> <out> --semitones=N" );
		var target = absolute( needArg( args, 2, "pitch <in> <out> --semitones=N" ) );
		if( !options.keyExists( "semitones" ) ){
			throw( type = "bxaudio.cli", message = "Missing option. Usage: bx-audio pitch <in> <out> --semitones=2" );
		}
		out( "wrote " & audioSave( audioPitch( audioLoad( source ), val( options.semitones ) ), target ) );
	}

	function cmdBpm( required array args, required struct options ){
		var r = audioBpm( audioLoad( needFile( args, 1, "bpm <file>" ) ) );
		if( r.bpm == 0 ){
			out( "No clear pulse found." );
			return;
		}
		out( numberFormat( r.bpm, "0.0" ) & " BPM (confidence " & numberFormat( r.confidence, "0.00" ) & ")" );
		if( options.keyExists( "beats" ) && options.beats != false ){
			out( r.beats.map( ( b ) => numberFormat( b, "0.00" ) ).toList( " " ) );
		}
	}

	function cmdSilence( required array args, required struct options ){
		var source = needFile( args, 1, "silence <file>" );
		var audio = audioLoad( source );
		if( options.keyExists( "trim" ) ){
			out( "wrote " & audioSave( audioTrimSilence( audio, val( options.thresholdDb ?: -50 ) ), absolute( options.trim ) ) );
			return;
		}
		var found = audioDetectSilence( audio, val( options.thresholdDb ?: -50 ), val( options.min ?: 0.3 ) );
		if( !found.len() ){
			out( "No silence found." );
			return;
		}
		found.each( ( r ) => out( numberFormat( r.start, "0.00" ) & " s to " & numberFormat( r.end, "0.00" ) & " s  (" & numberFormat( r.duration, "0.00" ) & " s)" ) );
	}

	function cmdWaveform( required array args, required struct options ){
		var file = needFile( args, 1, "waveform <file>" );
		var width = int( options.width ?: 60 );
		// Plain characters work in every terminal. The block characters look better where the console speaks UTF-8.
		var unicode = options.keyExists( "unicode" ) && options.unicode != false;
		var glyphs = unicode ? [ " ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ] : [ " ", ".", ":", "-", "=", "+", "*", "##", "@" ];
		var peaks = audioWaveform( audioLoad( file ), width );
		var top = max( 0.0001, peaks.max() );
		out( peaks.map( ( p ) => glyphs[ 1 + min( 8, int( round( p / top * 8 ) ) ) ] ).toList( "" ) );
	}

	function cmdVoices( required array args, required struct options ){
		var flag = ( name ) => options.keyExists( name ) && options[ name ] != false;
		if( args.len() ){
			return voiceDetail( args.first() );
		}
		var status = flag( "all" ) ? "all" : flag( "excluded" ) ? "excluded" : flag( "installed" ) ? "installed" : flag( "downloadable" ) ? "downloadable" : "offered";
		var language = ( options.lang ?: "all" ) == "all" ? "" : options.lang;
		var voices = audioVoices( language = language, status = status, license = options.license ?: "" );
		if( !voices.len() ){
			out( "No voices match." );
			return;
		}
		out( pad( "VOICE", 34 ) & pad( "LICENSE", 15 ) & pad( "SIZE", 9 ) & "STATUS" );
		voices.each( ( v ) => out( pad( v.id, 34 ) & pad( v.license.len() ? v.license : "-", 15 ) & pad( numberFormat( v.sizeMB, "0.0" ) & " MB", 9 ) & ( v.status == "excluded" ? "not offered: " & v.reason : v.status ) ) );
		out( "" );
		if( status != "excluded" ){
			out( "Only voices whose model card states an open license are offered, and the license is the one the card gives. Check it fits your use." );
			if( voices.some( ( v ) => v.shareAlike ) ){
				out( "CC-BY-SA voices ask that you share what you make from them under the same terms." );
			}
			out( "Install one with `bx-audio install <voice>`, or just use it: `bx-audio speak ""Hello"" --voice=<voice>`." );
			if( status == "offered" || status == "downloadable" ){
				var hidden = audioVoices( status = "excluded", language = language ).len();
				out( hidden & " more voices are not offered (license, language or engine limits). See them with `bx-audio voices --excluded`." );
			}
		} else {
			out( "These voices are not offered. The reason is per voice; `bx-audio licenses` explains the licenses that are." );
		}
	}

	private function voiceDetail( required string name ){
		var all = audioVoices( status = "all" );
		var found = all.filter( ( v ) => v.id.lcase() == name.lcase() );
		if( !found.len() ){
			found = all.filter( ( v ) => v.name.lcase() == name.lcase() );
		}
		if( found.len() > 1 ){
			throw( type = "bxaudio.cli", message = "More than one voice is called [#name#], use the full id: " & found.map( ( v ) => v.id ).toList( ", " ) );
		}
		if( !found.len() ){
			throw( type = "bxaudio.cli", message = "Unknown voice [#name#]. Run `bx-audio voices --all` to see every voice." );
		}
		var v = found.first();
		out( v.id );
		out( "  language     " & v.language );
		out( "  quality      " & v.quality );
		out( "  size         " & numberFormat( v.sizeMB, "0.0" ) & " MB" );
		out( "  card says    " & ( v.licenseText.len() ? v.licenseText : "no license stated" ) );
		out( "  status       " & ( v.status == "excluded" ? "not offered: " & v.reason : v.status ) );
		if( v.license.len() ){
			var info = audioLicenses().filter( ( l ) => l.id == v.license );
			out( "  license      " & v.license );
			if( info.len() ){
				out( "               " & info.first().summary );
				out( "               " & info.first().url );
			}
		}
		out( "  training     " & ( v.source.len() ? v.source : "not stated" ) );
		if( v.status == "installed" ){
			out( "  stored in    " & audioSpeechStatus().voicesDir );
		}
	}

	function cmdLicenses( required array args, required struct options ){
		out( pad( "LICENSE", 15 ) & pad( "COMMERCIAL", 12 ) & pad( "CREDIT", 8 ) & pad( "SHARE-ALIKE", 13 ) & "VOICES" );
		audioLicenses().each( ( l ) => out( pad( l.id, 15 ) & pad( l.commercial ? "yes" : "no", 12 ) & pad( l.attribution ? "yes" : "no", 8 ) & pad( l.shareAlike ? "yes" : "no", 13 ) & l.voices ) );
		out( "" );
		audioLicenses().each( ( l ) => {
			out( l.id & ": " & l.summary );
			out( "  " & l.url );
		} );
		out( "" );
		out( "This is a summary, not legal advice. The model card of each voice is the authority. Voices with non-commercial, custom or unclear licenses are never offered." );
	}

	function cmdInstall( required array args, required struct options ){
		if( !args.len() ){
			throw( type = "bxaudio.cli", message = "Missing argument. Usage: bx-audio install <voice|engine> [...]" );
		}
		for( var name in args ){
			var info = audioVoiceInstall( name, progressPrinter() );
			out( ( info.name == "engine" ? "installed the speech engine in " : "installed " & info.name & " at " ) & info.path );
		}
	}

	function cmdRemove( required array args, required struct options ){
		if( !args.len() ){
			throw( type = "bxaudio.cli", message = "Missing argument. Usage: bx-audio remove <voice|engine> [...]" );
		}
		for( var name in args ){
			out( audioVoiceRemove( name ) ? "removed " & name : name & " was not installed" );
		}
	}

	function cmdWhere( required array args, required struct options ){
		var storage = audioStorage();
		out( "bx-audio home: " & storage.home );
		out( "" );
		out( pad( "FOLDER", 9 ) & pad( "SIZE", 11 ) & "WHAT" );
		storage.folders.each( ( f ) => {
			out( pad( f.kind, 9 ) & pad( f.exists ? numberFormat( f.sizeMB, "0.0" ) & " MB" : "-", 11 ) & f.description );
			out( "         " & f.path );
		} );
		out( "" );
		out( "Total " & numberFormat( storage.totalMB, "0.0" ) & " MB. Move it with the BX_AUDIO_HOME variable or the module's home setting. Free space with `bx-audio clean`." );
	}

	function cmdClean( required array args, required struct options ){
		var kind = args.len() ? args.first().lcase() : "all";
		if( !( options.keyExists( "yes" ) && options.yes != false ) ){
			var storage = audioStorage();
			out( "This deletes [#kind#] from #storage.home#. Add --yes to do it. Downloads happen again on next use." );
			return;
		}
		out( "freed " & numberFormat( audioStorageClear( kind ), "0.0" ) & " MB" );
	}

	function cmdSpeak( required array args, required struct options ){
		var text = args.toList( " " );
		if( options.keyExists( "file" ) ){
			var path = absolute( options.file );
			if( !fileExists( path ) ){
				throw( type = "bxaudio.cli", message = "File not found: #path#" );
			}
			text = fileRead( path );
		}
		if( !text.trim().len() ){
			throw( type = "bxaudio.cli", message = "Missing text. Usage: bx-audio speak <text> --voice=NAME" );
		}
		if( !options.keyExists( "voice" ) ){
			throw( type = "bxaudio.cli", message = "Choose a voice with --voice=NAME. See them with `bx-audio voices`." );
		}
		var target = absolute( options.out ?: "speech.wav" );
		var install = ( options.install ?: true ) != false;
		var speed = val( options.speed ?: 1 );
		var pieceByPiece = [ "captions", "by-clause", "sentence-pause", "clause-pause", "paragraph-pause" ].some( ( k ) => options.keyExists( k ) );
		if( !pieceByPiece ){
			var audio = audioSpeak( text = text, voice = options.voice, autoInstall = install, onProgress = progressPrinter(), speed = speed );
			var written = audioSave( audio, target );
			out( "wrote " & written & " (" & numberFormat( audio.getDurationSeconds(), "0.0" ) & " s)" );
			return;
		}
		var pauses = {};
		[ "sentence", "clause", "paragraph" ].each( ( k ) => {
			if( options.keyExists( k & "-pause" ) ){
				pauses[ k ] = val( options[ k & "-pause" ] );
			}
		} );
		var spoken = audioSpeakCues(
			text = text,
			voice = options.voice,
			speed = speed,
			pauses = pauses,
			maxChars = int( options[ "max-chars" ] ?: 80 ),
			split = options.keyExists( "by-clause" ) && options[ "by-clause" ] != false ? "clause" : "sentence",
			autoInstall = install,
			onProgress = progressPrinter()
		);
		out( "wrote " & audioSave( spoken.audio, target ) & " (" & numberFormat( spoken.seconds, "0.0" ) & " s)" );
		if( options.keyExists( "captions" ) ){
			var captions = absolute( options.captions );
			var format = captions.lcase().endsWith( ".vtt" ) ? "vtt" : "srt";
			audioSubtitles( cues = spoken.cues, format = format, path = captions, offset = val( options.offset ?: 0 ) );
			out( "wrote " & captions & " (" & spoken.cues.len() & " captions)" );
		}
	}

	function cmdPieces( required array args, required struct options ){
		catalog().each( ( p ) => out( pad( p.id, 11 ) & pad( p.style, 22 ) & p.blurb ) );
		out( "" );
		out( "Render one with `bx-audio render <piece>`, or open them all with `bx-audio explorer`." );
	}

	function cmdRender( required array args, required struct options ){
		var id = needArg( args, 1, "render <piece>" ).lcase();
		var found = catalog().filter( ( p ) => p.id == id );
		if( !found.len() ){
			throw( type = "bxaudio.cli", message = "Unknown piece [#id#]. Run `bx-audio pieces` to see them." );
		}
		var piece = found.first();
		var target = absolute( options.out ?: ( piece.id & ".wav" ) );
		var settings = { "out" : target };
		var known = piece.params.map( ( p ) => p.name );
		options.each( ( key, value ) => {
			if( key == "out" ){
				return;
			}
			if( !known.contains( key ) ){
				throw( type = "bxaudio.cli", message = "[#piece.id#] has no setting [#key#]. Its settings are: #known.toList( ', ' )#." );
			}
			settings[ key ] = value;
		} );
		// The example scripts read their settings from `overrides`, in their own scope
		request.audioJob = { "script" : root & "/examples/" & piece.script.replace( "../", "" ), "overrides" : settings };
		new bxModules.bxaudio.cli.Job();
		out( "" );
		out( "wrote " & target );
	}

	function cmdExplorer( required array args, required struct options ){
		var port = int( options.port ?: 8080 );
		var webroot = root & "/examples/explorer";
		if( !directoryExists( webroot ) ){
			throw( type = "bxaudio.cli", message = "The explorer was not found at [#webroot#]." );
		}
		var program = findOnPath( "boxlang-miniserver" );
		if( !program.len() ){
			throw( type = "bxaudio.cli", message = "The explorer needs the BoxLang MiniServer, which is not on your PATH. Install it from https://boxlang.ortusbooks.com/getting-started/installation, then run this again. Or start it yourself: boxlang-miniserver --webroot #webroot# --port #port#" );
		}
		out( "Starting the explorer at http://localhost:#port#/index.bxm (Ctrl+C to stop)" );
		var builder = createObject( "java", "java.lang.ProcessBuilder" ).init( [ program, "--webroot", webroot, "--port", port & "" ] );
		builder.inheritIO().start().waitFor();
	}

	function cmdDoctor( required array args, required struct options ){
		var problems = 0;
		var check = ( ok, label, fix = "" ) => {
			out( ( ok ? "  ok    " : "  FAIL  " ) & label );
			if( !ok ){
				problems++;
				if( fix.len() ){
					out( "        " & fix );
				}
			}
		};
		out( "bx-audio doctor" );
		check( true, "Java " & server.java.version );
		var desktop = createObject( "java", "java.lang.ModuleLayer" ).boot().findModule( "java.desktop" ).isPresent();
		check( desktop, "java.desktop module (needed to write MP3)", "Use a full JDK or a JRE that includes java.desktop." );
		var mp3 = false;
		try {
			var probe = getTempDirectory() & "/bx-audio-doctor-" & createUUID() & ".mp3";
			audioSave( audioOsc( "sine", 440, 0.2 ), probe );
			mp3 = audioInfo( probe ).frames > 0;
			fileDelete( probe );
		} catch( any e ){
			mp3 = false;
		}
		check( mp3, "MP3 write and read", "Check that jlayer and jump3r are in the module's libs folder. See licenses/THIRD-PARTY.md." );
		check( directoryExists( root & "/examples" ), "Examples folder", "Reinstall the module." );
		check( findOnPath( "boxlang-miniserver" ).len() > 0, "MiniServer on PATH (needed for the explorer)", "Install it from https://boxlang.ortusbooks.com/getting-started/installation" );
		var ff = audioFfmpeg();
		out( "  info  FFmpeg " & ( ff.available ? ff.version & " (" & ff.source & ")" : "not available: OGG, Opus, AAC and video need it" & ( ff.installable ? ", `bx-audio ffmpeg install` downloads " & numberFormat( ff.downloadSizeMB, "0" ) & " MB" : "" ) ) );
		var soundCard = false;
		try {
			soundCard = createObject( "java", "javax.sound.sampled.AudioSystem" ).getMixerInfo().len() > 0;
		} catch( any e ){
			soundCard = false;
		}
		out( "  info  audio output " & ( soundCard ? "found: `bx-audio play` and audioMixer() will play to the speakers" : "none found: use audioMixer( output=""memory"" ) or ""null"" on this computer" ) );
		var speech = audioSpeechStatus();
		out( "  info  speech engine " & ( speech.engineInstalled ? "installed" : "not installed (" & speech.engineSizeMB & " MB, `bx-audio install engine` or the first `speak` downloads it)" ) );
		out( "  info  downloads are kept in " & audioStorage().home & " (`bx-audio where`, `bx-audio clean`)" );
		out( "  info  voices installed: " & ( speech.voices.len() ? speech.voices.toList( ", " ) : "none" ) & " (in " & speech.home & ")" );
		out( problems ? "" & problems & " problem" & ( problems > 1 ? "s" : "" ) & " found." : "Everything looks good." );
	}

	// ---------------------------------------------------------------------------------------------------------------------------
	// Helpers
	// ---------------------------------------------------------------------------------------------------------------------------

	/**
	 * Print a line, and remember it
	 */
	function out( required string line ){
		variables.output &= line & createObject( "java", "java.lang.System" ).lineSeparator();
		println( line );
	}

	function getOutput(){
		return variables.output;
	}

	private function catalog(){
		var path = root & "/examples/explorer/catalog.json";
		if( !fileExists( path ) ){
			throw( type = "bxaudio.cli", message = "The examples were not found at [#root#/examples]. Reinstall the module." );
		}
		return jsonDeserialize( fileRead( path ) );
	}

	/**
	 * A download progress callback that prints a line each time a file passes another tenth
	 */
	private function progressPrinter(){
		var last = {};
		return ( name, done, total ) => {
			var tenth = int( done * 10 / total ) * 10;
			if( !last.keyExists( name ) || tenth > last[ name ] ){
				last[ name ] = tenth;
				out( "  " & name & " " & tenth & "%" );
			}
		};
	}

	/**
	 * Pad text with spaces on the right, for columns
	 */
	private static function pad( required string text, required numeric width ){
		return text.len() >= width ? text & " " : text & repeatString( " ", width - text.len() );
	}

	private static function needArg( required array args, required numeric position, required string usage ){
		if( args.len() < position ){
			throw( type = "bxaudio.cli", message = "Missing argument. Usage: bx-audio #usage#" );
		}
		return args[ position ];
	}

	/**
	 * Paths given on the command line are relative to where the person ran the command, not to the module or the example scripts
	 */
	private static function absolute( required string path ){
		var Paths = createObject( "java", "java.nio.file.Paths" );
		var given = Paths.get( path, [] );
		return given.isAbsolute() ? path : Paths.get( createObject( "java", "java.lang.System" ).getProperty( "user.dir" ), [ path ] ).toString();
	}

	private function needFile( required array args, required numeric position, required string usage ){
		var file = absolute( needArg( args, position, usage ) );
		if( !fileExists( file ) ){
			throw( type = "bxaudio.cli", message = "File not found: #file#" );
		}
		ensureFfmpeg( file );
		return file;
	}

	/**
	 * Formats the module does not read or write itself need FFmpeg. Download it, with a progress line, the first time one is used.
	 */
	private function ensureFfmpeg( required string file ){
		var ext = file.listLast( "." ).lcase();
		if( [ "wav", "wave", "mp3", "flac" ].contains( ext ) || !file.find( "." ) ){
			return;
		}
		var status = audioFfmpeg();
		if( !status.available ){
			out( "Reading and writing ." & ext & " files needs FFmpeg." );
			if( status.installable && status.autoInstall ){
				var info = audioFfmpegInstall( progressPrinter() );
				out( "installed FFmpeg " & info.version );
			} else {
				throw( type = "bxaudio.ffmpegMissing", message = "FFmpeg is needed for ." & ext & " files and was not found. Run `bx-audio ffmpeg install` to download it, or install FFmpeg so it is on the PATH." );
			}
		}
	}

	private static function findOnPath( required string program ){
		var names = server.os.name.lcase().contains( "windows" ) ? [ program & ".bat", program & ".exe", program ] : [ program ];
		for( var dir in ( server.system.environment.PATH ?: "" ).listToArray( server.os.name.lcase().contains( "windows" ) ? ";" : ":" ) ){
			for( var name in names ){
				if( fileExists( dir & "/" & name ) ){
					return dir & "/" & name;
				}
			}
		}
		return "";
	}

}

#compdef bx-audio
# Tab completion for bx-audio. Generated by tools/generate-docs.bxs, do not edit. Print it again with `bx-audio completions zsh`.
# Load it with: bx-audio completions zsh > "${fpath[1]}/_bx-audio" and start a new shell, or: source <(bx-audio completions zsh)
_bx-audio() {
    local -a commands
    commands=(
        'info:Show the format, length and level of an audio file'
        'convert:Convert between WAV, MP3 and FLAC (and OGG, Opus and AAC with FFmpeg), and change the sample rate or channels'
        'normalize:Scale the peak of a file to a level in decibels'
        'trim:Cut a section out of a file'
        'loudness:Measure the loudness in LUFS (EBU R128), the loudness range and the true peak'
        'master:Reach a loudness target with a true-peak ceiling, ready to publish'
        'stretch:Change the speed or fit the length, keeping the pitch'
        'pitch:Change the pitch, keeping the length'
        'bpm:Detect the tempo, and with --beats list where the beats fall'
        'silence:List the silent stretches, or write a copy with the silence cut off both ends'
        'waveform:Draw the loudness of a file on one line, with block characters if you add --unicode'
        'speak:Say a text with an open license voice, installing the engine and the voice the first time'
        'voices:List voices with their licenses, what is installed, and why some are not offered'
        'credits:Print the credits the licenses of some voices ask for, to put on an about page'
        'licenses:Show the voice licenses and what each one asks of you'
        'install:Download a voice, or the speech engine every voice needs'
        'remove:Delete a downloaded voice, or the speech engine'
        'where:Show where bx-audio keeps its downloads, and how much space they take'
        'clean:Delete downloaded files to free space, after asking'
        'play:Play a file through the speakers'
        'loopify:Make a sound loop seamlessly by blending its end into its start'
        'sprite:Join sounds into one audio sprite with a Howler'
        'ffmpeg:Show whether FFmpeg is available (OGG, Opus, AAC and video need it), or download it'
        'probe:Describe any audio or video file - length, size, video and audio streams'
        'mux:Put an audio file on a video, copying the picture without re-encoding'
        'pieces:List the example pieces of music you can render'
        'render:Synthesize an example piece to an audio file'
        'explorer:Start the web explorer on the BoxLang MiniServer (this machine only unless you give a --host)'
        'doctor:Check that MP3, FFmpeg, audio output, the examples and the explorer will work here'
        'completions:Print the tab completion script of a shell'
        'version:Show the module version'
        'help:Show this help'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'bx-audio command' commands
        return
    fi
    case $words[2] in
        info)
            _arguments '*:file:_files' ;;
        convert)
            _arguments '--bitrate=[bitrate]:bitrate:' '--bitDepth=[bitDepth]:bitDepth:' '--sampleRate=[sampleRate]:sampleRate:' '--channels=[channels]:channels:' '*:file:_files' ;;
        normalize)
            _arguments '--targetDb=[targetDb]:targetDb:' '*:file:_files' ;;
        trim)
            _arguments '--start=[start]:start:' '--end=[end]:end:' '*:file:_files' ;;
        loudness)
            _arguments '*:file:_files' ;;
        master)
            _arguments '--target=[target]:target:(streaming podcast broadcast)' '--truePeakDb=[truePeakDb]:truePeakDb:' '--glue' '*:file:_files' ;;
        stretch)
            _arguments '--rate=[rate]:rate:' '--seconds=[seconds]:seconds:' '*:file:_files' ;;
        pitch)
            _arguments '--semitones=[semitones]:semitones:' '*:file:_files' ;;
        bpm)
            _arguments '--beats' '*:file:_files' ;;
        silence)
            _arguments '--thresholdDb=[thresholdDb]:thresholdDb:' '--min=[min]:min:' '--trim=[trim]:trim:' '*:file:_files' ;;
        waveform)
            _arguments '--width=[width]:width:' '--unicode' '*:file:_files' ;;
        speak)
            _arguments '--voice=[voice]:voice:' '--out=[out]:out:' '--file=[file]:file:' '--speed=[speed]:speed:' '--captions=[captions]:captions:' '--no-install' '--offset=[offset]:offset:' '--max-chars=[max-chars]:max-chars:' '--by-clause' '--sentence-pause=[sentence-pause]:sentence-pause:' '--clause-pause=[clause-pause]:clause-pause:' '--paragraph-pause=[paragraph-pause]:paragraph-pause:' ;;
        voices)
            _arguments '--lang=[lang]:lang:' '--installed' '--downloadable' '--excluded' '--all' '--license=[license]:license:' '--usage=[usage]:usage:' ;;
        credits)
            _message 'no arguments' ;;
        licenses)
            _message 'no arguments' ;;
        install)
            _arguments '*:install:(bryce joe john kathleen kristin en_US-ljspeech-high en_US-ljspeech-medium mike norman reza_ibrahim sam engine)' ;;
        remove)
            _arguments '*:remove:(bryce joe john kathleen kristin en_US-ljspeech-high en_US-ljspeech-medium mike norman reza_ibrahim sam engine)' ;;
        where)
            _message 'no arguments' ;;
        clean)
            _arguments '--yes' '*:clean:(engine voices ffmpeg cache all)' ;;
        play)
            _arguments '--volume=[volume]:volume:' '--output=[output]:output:(speakers null)' '*:file:_files' ;;
        loopify)
            _arguments '--crossfade=[crossfade]:crossfade:' '*:file:_files' ;;
        sprite)
            _arguments '--gap=[gap]:gap:' '*:file:_files' ;;
        ffmpeg)
            _arguments '*:ffmpeg:(status install)' ;;
        probe)
            _arguments '*:file:_files' ;;
        mux)
            _arguments '--keep-original' '--offset=[offset]:offset:' '*:file:_files' ;;
        pieces)
            _message 'no arguments' ;;
        render)
            _arguments '--out=[out]:out:' '--bars=[bars]:bars:' '--bpm=[bpm]:bpm:' '--style=[style]:style:' '--swing=[swing]:swing:' '--seed=[seed]:seed:' '--track=[track]:track:' '--loops=[loops]:loops:' '--sound=[sound]:sound:' '--choruses=[choruses]:choruses:' '--voice=[voice]:voice:' '--speed=[speed]:speed:' '--text=[text]:text:' '--duck=[duck]:duck:' '--seconds=[seconds]:seconds:' '--target=[target]:target:' '*:render:(pop-drive lofi house ambient techno synthwave cinematic chiptune sfx jazz rock voiceover trailer game-audio theme sampler)' ;;
        explorer)
            _arguments '--port=[port]:port:' '--host=[host]:host:' ;;
        doctor)
            _message 'no arguments' ;;
        completions)
            _arguments '*:completions:(bash zsh fish powershell)' ;;
        version)
            _message 'no arguments' ;;
        help)
            _arguments '*:help:(info convert normalize trim loudness master stretch pitch bpm silence waveform speak voices credits licenses install remove where clean play loopify sprite ffmpeg probe mux pieces render explorer doctor completions version help)' ;;
    esac
}
if [ "$funcstack[1]" = "_bx-audio" ]; then
    _bx-audio "$@"
else
    compdef _bx-audio bx-audio
fi

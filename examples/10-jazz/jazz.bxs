/**
 * Jazz: a trio playing a twelve bar blues in F at 132 BPM with a swing feel. A walking bass, a ride cymbal with a chick on two and four,
 * an electric piano comping on the off beats, and a saxophone like lead. The first chorus plays the head, the next ones are improvised
 * solos, and the last chorus plays the head again and ends on a held F.
 *
 * Nothing is written note for note. The bass walks and the solo is improvised by a seeded random number generator that follows the
 * chords: it lands on a chord tone on the strong beats, moves mostly by step through the scale of each chord, and takes a breath every
 * two bars. The same seed gives the same solo, another seed gives another one.
 *
 * Usage:
 *   boxlang jazz.bxs [--out=out/jazz.wav] [--choruses=3] [--bpm=132] [--swing=0.64] [--seed=4]
 */

settings = { out : "out/jazz.wav", choruses : 3, bpm : 132, swing : 0.64, seed : 4 };
settings.append( cliGetArgs().options );
// Settings preset by whoever runs the script from code (tests, the explorer, the bx-audio CLI) win over the command line
if( isDefined( "overrides" ) ){
	settings.append( overrides );
}

sr = 44100;
choruses = max( 2, int( settings.choruses ) );
bpm = settings.bpm * 1.0;
swing = settings.swing * 1.0;
beat = 60 / bpm;
bar = beat * 4;

// Park Miller random numbers, scaled 0 to 1. Seeded, so every run is identical
rngState = 1;
function seedRandom( value ){
	rngState = int( value ) + 1;
}
function rnd(){
	rngState = ( rngState * 48271 ) mod 2147483647;
	return rngState / 2147483647;
}

// ---------------------------------------------------------------------------------------------------------------------------------
// The twelve bar blues in F. Each bar has two chords, one for each half, the same twice when the chord stays.
// ---------------------------------------------------------------------------------------------------------------------------------
blues = [
	[ "F7", "F7" ], [ "Bb7", "Bb7" ], [ "F7", "F7" ], [ "F7", "F7" ],
	[ "Bb7", "Bb7" ], [ "Bb7", "Bb7" ], [ "F7", "F7" ], [ "D7", "D7" ],
	[ "Gm7", "Gm7" ], [ "C7", "C7" ], [ "F7", "D7" ], [ "Gm7", "C7" ]
];
pitchClass = { C : 0, "C##" : 1, Db : 1, D : 2, Eb : 3, E : 4, F : 5, "F##" : 6, Gb : 6, G : 7, Ab : 8, "G##" : 8, A : 9, Bb : 10, B : 11 };

/**
 * A chord symbol such as "F7", "Bb7" or "Gm7" as its root pitch class, its quality, the notes of its scale as semitones above the root,
 * and its chord tones (root, third, fifth, seventh)
 */
function chordInfo( symbol ){
	var minor = symbol.contains( "m7" );
	var name = symbol.reReplace( "m?7$", "" );
	return {
		root : pitchClass[ name ],
		minor : minor,
		// Dorian over a minor seventh chord, Mixolydian over a dominant one
		scale : minor ? [ 0, 2, 3, 5, 7, 9, 10 ] : [ 0, 2, 4, 5, 7, 9, 10 ],
		tones : [ 0, minor ? 3 : 4, 7, 10 ]
	};
}

// ---------------------------------------------------------------------------------------------------------------------------------
// Voices
// ---------------------------------------------------------------------------------------------------------------------------------
bassCache = {};
function bassNote( midi, beats ){
	var id = midi & "|" & beats;
	if( !bassCache.keyExists( id ) ){
		var seconds = beats * beat;
		var tone = audioMix( [
			audioOsc( shape = "triangle", freq = audioFreq( midi ), seconds = seconds, sampleRate = sr ),
			audioGain( audioOsc( shape = "sine", freq = audioFreq( midi + 12 ), seconds = seconds, sampleRate = sr ), -9 )
		] );
		bassCache[ id ] = audioFade( audioFilter( audioEnvelope( tone, 0.004, 0.3 ), "lowpass", 900, 0.7071 ), 0, min( 0.04, seconds / 2 ) );
	}
	return bassCache[ id ];
}

pianoCache = {};
function pianoChord( midis, beats ){
	var id = midis.toList() & "|" & beats;
	if( !pianoCache.keyExists( id ) ){
		var seconds = beats * beat;
		var tones = midis.map( ( m ) => audioOsc( shape = "additive", freq = audioFreq( m ), seconds = seconds, sampleRate = sr,
			partials = [ [ 1, 1 ], [ 2, 0.45 ], [ 3, 0.2 ], [ 4, 0.1 ], [ 6, 0.04 ] ] ) );
		pianoCache[ id ] = audioGain( audioFade( audioFilter( audioEnvelope( audioMix( tones ), 0.004, 0.45 ), "lowpass", 3800, 0.7071 ), 0, min( 0.05, seconds / 2 ) ), -12 );
	}
	return pianoCache[ id ];
}

saxCache = {};
function saxNote( midi, beats ){
	var id = midi & "|" & beats;
	if( !saxCache.keyExists( id ) ){
		var seconds = beats * beat;
		var tone = audioMix( [
			audioOsc( shape = "saw", freq = audioFreq( midi - 0.08 ), seconds = seconds, sampleRate = sr, harmonics = 14 ),
			audioOsc( shape = "saw", freq = audioFreq( midi + 0.08 ), seconds = seconds, sampleRate = sr, harmonics = 14 ),
			audioGain( audioOsc( shape = "square", freq = audioFreq( midi ), seconds = seconds, sampleRate = sr, harmonics = 8 ), -5 )
		] );
		saxCache[ id ] = audioGain( audioFade( audioFilter( audioEnvelope( tone, 0.03, 1.2 ), "lowpass", 2600, 1.0 ), 0, min( 0.06, seconds / 2 ) ), -17 );
	}
	return saxCache[ id ];
}

rides = [];
for( i = 1; i <= 3; i++ ){
	rides.append( audioEnvelope( audioFilter( audioNoise( seconds = 0.35, sampleRate = sr, seed = 70 + i, color = "white" ), "bandpass", 7200, 1.1 ), 0.001, 0.09 ) );
}
chick = audioDrum( type = "hat", seed = 81, pitch = 0.8, level = 0.5 );
feather = audioDrum( type = "kick", pitch = 1.25, decay = 0.5, level = 0.3 );
ghosts = [];
for( i = 1; i <= 3; i++ ){
	ghosts.append( audioFilter( audioDrum( type = "snare", seed = 90 + i, decay = 0.4, level = 0.3 ), "lowpass", 5000, 0.7071 ) );
}
crash = audioDrum( type = "crash", seed = 99, decay = 1.0, level = 0.5 );

// ---------------------------------------------------------------------------------------------------------------------------------
// Walking bass, comping and the improvised line
// ---------------------------------------------------------------------------------------------------------------------------------

/**
 * The bass note for a chord tone, in the bass register: E2 to D#3 (MIDI 40 to 51)
 */
function bassMidi( rootPc, offset ){
	var midi = 36 + ( ( rootPc + offset ) mod 12 );
	return midi < 40 ? midi + 12 : midi;
}

/**
 * Rootless piano voicing: third, seventh, ninth and thirteenth (a minor chord gets the eleventh), folded into the range around middle C
 */
function voicing( info ){
	var offsets = info.minor ? [ 3, 10, 14, 17 ] : [ 4, 10, 14, 21 ];
	return offsets.map( ( o ) => {
		var midi = 48 + ( ( info.root + o ) mod 12 );
		return midi < 54 ? midi + 12 : midi;
	} );
}

/**
 * Every note of the scale between two MIDI notes, lowest first
 */
function scaleNotes( info, low, high ){
	var notes = [];
	for( var m = low; m <= high; m++ ){
		if( info.scale.contains( ( m - info.root + 120 ) mod 12 ) ){
			notes.append( m );
		}
	}
	return notes;
}

/**
 * One bar of improvised eighth notes for the lead, as an array of { at : eighth 0 to 7, midi, length : in eighths }. `density` is the
 * chance that an off beat eighth is played, `breath` leaves the end of the bar empty, and `previous` is where the last bar ended, as an
 * index into the scale so it carries across chord changes by pitch.
 */
function soloBar( chordA, chordB, previousMidi, density, breath ){
	var notes = [];
	var direction = rnd() < 0.5 ? 1 : -1;
	var midi = previousMidi;
	var at = 0;
	while( at < 8 ){
		var info = at < 4 ? chordA : chordB;
		var scale = scaleNotes( info, 64, 86 );
		// where in this chord's scale the line is now
		var index = 1;
		for( var i = 1; i <= scale.len(); i++ ){
			if( abs( scale[ i ] - midi ) < abs( scale[ index ] - midi ) ){
				index = i;
			}
		}
		var strong = ( at == 0 || at == 4 );
		if( strong ){
			// land on a chord tone close to where the line is
			var best = index;
			var bestDistance = 99;
			for( var j = 1; j <= scale.len(); j++ ){
				if( info.tones.contains( ( scale[ j ] - info.root + 120 ) mod 12 ) && abs( scale[ j ] - midi ) < bestDistance ){
					best = j;
					bestDistance = abs( scale[ j ] - midi );
				}
			}
			index = best;
		} else {
			var roll = rnd();
			if( roll < 0.18 ){
				direction = -direction;
			}
			// mostly by step, sometimes a third
			index += direction * ( rnd() < 0.78 ? 1 : 2 );
			index = max( 1, min( scale.len(), index ) );
			if( index == 1 || index == scale.len() ){
				direction = -direction;
			}
		}
		midi = scale[ index ];
		var offbeat = ( at mod 2 == 1 );
		var play = !( breath && at >= 5 ) && ( !offbeat || rnd() < density );
		if( play ){
			// hold the note through the following eighth sometimes, so the line breathes
			var length = ( !offbeat && rnd() < ( density < 0.7 ? 0.7 : 0.25 ) && at < 7 ) ? 2 : 1;
			notes.append( { at : at, midi : midi, length : length } );
			at += length;
		} else {
			at++;
		}
	}
	return notes;
}

// ---------------------------------------------------------------------------------------------------------------------------------
// The arrangement
// ---------------------------------------------------------------------------------------------------------------------------------
function newStem(){
	return audioTimeline( bpm = bpm, beatsPerBar = 4, sampleRate = sr, channels = 2 );
}
function put( stem, sound, at, pan, db ){
	audioAdd( timeline = stem, sound = sound, at = at, track = "main", db = db, pan = pan );
}
// The time of an eighth note in a bar: the off beats are late, which is the swing
function eighthTime( barStart, eighth ){
	return barStart + ( int( eighth / 2 ) + ( eighth mod 2 == 1 ? swing : 0 ) ) * beat;
}

drumStem = newStem();
bassStem = newStem();
pianoStem = newStem();
leadStem = newStem();

// The head is written once, so the last chorus plays exactly what the first one did
seedRandom( 1000 );
headLine = [];
lastMidi = 72;
for( b = 1; b <= 12; b++ ){
	line = soloBar( chordInfo( blues[ b ][ 1 ] ), chordInfo( blues[ b ][ 2 ] ), lastMidi, 0.35, b mod 2 == 0 );
	headLine.append( line );
	if( line.len() ){
		lastMidi = line.last().midi;
	}
}

seedRandom( settings.seed );
lastSolo = 74;
totalBars = choruses * 12;
for( chorus = 1; chorus <= choruses; chorus++ ){
	isHead = ( chorus == 1 || chorus == choruses );
	for( b = 1; b <= 12; b++ ){
		barIndex = ( chorus - 1 ) * 12 + b - 1;
		t0 = barIndex * bar;
		chordA = chordInfo( blues[ b ][ 1 ] );
		chordB = chordInfo( blues[ b ][ 2 ] );
		nextChord = chordInfo( blues[ ( b mod 12 ) + 1 ][ 1 ] );
		isLast = ( barIndex == totalBars - 1 );

		// Drums: ride on every beat plus the skip note, chick on two and four, a feathered kick, and now and then a ghost snare
		for( k = 0; k < 4; k++ ){
			if( isLast && k > 0 ){
				continue;
			}
			put( drumStem, rides[ ( k mod 3 ) + 1 ], t0 + k * beat, 0.25, k mod 2 == 0 ? -9 : -11 );
			put( drumStem, feather, t0 + k * beat, 0, -24 );
			if( k == 1 || k == 3 ){
				put( drumStem, chick, t0 + k * beat, -0.2, -14 );
				put( drumStem, rides[ 1 ], eighthTime( t0, k * 2 + 1 ), 0.25, -13 );
			}
		}
		if( !isLast && rnd() < 0.4 ){
			put( drumStem, ghosts[ int( rnd() * 3 ) + 1 ], eighthTime( t0, rnd() < 0.5 ? 3 : 5 ), -0.1, -20 );
		}
		if( isLast ){
			put( drumStem, crash, t0, 0, -10 );
		}

		// Walking bass: the root, then chord tones, then a half step from the next root, one note a beat
		if( isLast ){
			put( bassStem, bassNote( bassMidi( chordA.root, 0 ), 3 ), t0, 0, -3 );
		} else {
			put( bassStem, bassNote( bassMidi( chordA.root, 0 ), 1 ), t0, 0, -2 );
			put( bassStem, bassNote( bassMidi( chordB.root, rnd() < 0.5 ? chordB.tones[ 2 ] : chordB.tones[ 3 ] ), 1 ), t0 + beat, 0, -4 );
			put( bassStem, bassNote( bassMidi( chordB.root, rnd() < 0.5 ? chordB.tones[ 3 ] : chordB.tones[ 4 ] ), 1 ), t0 + 2 * beat, 0, -4 );
			put( bassStem, bassNote( bassMidi( nextChord.root, rnd() < 0.5 ? -1 : 1 ), 1 ), t0 + 3 * beat, 0, -4 );
		}

		// Comping: a chord on one, and one on the off beat of two, sometimes of four
		if( isLast ){
			put( pianoStem, pianoChord( voicing( chordA ), 3 ), t0, -0.25, 0 );
		} else {
			put( pianoStem, pianoChord( voicing( chordA ), 1.2 ), t0, -0.25, -1 );
			put( pianoStem, pianoChord( voicing( chordB ), 0.5 ), eighthTime( t0, 3 ), -0.25, -3 );
			if( rnd() < 0.45 ){
				put( pianoStem, pianoChord( voicing( chordB ), 0.5 ), eighthTime( t0, 7 ), -0.25, -5 );
			}
		}

		// The lead: the head in the first and last chorus, an improvised line in between
		if( isLast ){
			put( leadStem, saxNote( 65, 3 ), t0, 0.25, -1 );
		} else {
			if( isHead ){
				line = headLine[ b ];
			} else {
				line = soloBar( chordA, chordB, lastSolo, 0.85, b mod 2 == 0 );
				if( line.len() ){
					lastSolo = line.last().midi;
				}
			}
			for( n in line ){
				put( leadStem, saxNote( n.midi, n.length * 0.5 ), eighthTime( t0, n.at ), 0.25, n.at == 0 ? -1 : -3 );
			}
		}
	}
}

drums = audioRender( timeline = drumStem, tail = 1.5 );
bassOut = audioRender( timeline = bassStem, tail = 1 );
piano = audioReverb( audio = audioRender( timeline = pianoStem, tail = 2 ), room = 0.3, damp = 0.6, mix = 0.12 );
lead = audioRender( timeline = leadStem, tail = 1.5 );
lead = audioReverb( audio = audioChorus( audio = lead, rate = 0.4, depth = 0.002, mix = 0.25 ), room = 0.35, damp = 0.5, mix = 0.14 );

mix = audioMix( [ drums, audioGain( bassOut, 0 ), piano, lead ] );
mix = audioFilter( mix, "highpass", 35, 0.7071 );
mix = audioSaturate( mix, 1.4, 0.9 );
written = audioSave( mix, settings.out );
println( "wrote " & written & " " & numberFormat( audioInfo( mix ).seconds, "0.0" ) & " s, " & choruses & " choruses of the blues at " & bpm & " bpm" );

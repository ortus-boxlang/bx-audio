/**
 * Chiptune: original music for an 8 bit console, made the way those machines made it. Two pulse wave channels (one plays the melody,
 * one plays arpeggios), a triangle wave for the bass, and a noise channel for the drums. Nothing else: no reverb, no filters, no samples.
 *
 * It holds five tracks, all written for this module: overworld (bouncy, C major), cave (sparse and echoing, A minor), boss (fast and
 * driving, D minor), title (a fanfare, G major) and victory (a short jingle, C major). Each track is a few lines of data: its chords, and
 * its melody written as text. Every bar of a melody is 16 tokens, one per sixteenth note: a note name starts a note, `-` holds it, and `.`
 * is a rest.
 *
 * Usage:
 *   boxlang chiptune.bxs [--track=overworld] [--out=out/chiptune-overworld.wav] [--loops=2] [--bpm=150]
 */

settings = { track : "overworld", out : "", loops : 0, bpm : 0 };
settings.append( cliGetArgs().options );
// Settings preset by whoever runs the script from code (tests, the explorer, the bx-audio CLI) win over the command line
if( isDefined( "overrides" ) ){
	settings.append( overrides );
}

sr = 44100;

// ---------------------------------------------------------------------------------------------------------------------------------
// The tracks. `chords` has one chord per bar of a phrase, `melody` one bar of 16 tokens per bar, and `form` is the order of the phrases.
// `bass` is a bar of 16 tokens: R is the chord root, O the octave above it, F the fifth, `-` holds and `.` rests.
// `drums` is a bar of 16 characters: k kick, s snare, h hat, `.` nothing.
// ---------------------------------------------------------------------------------------------------------------------------------
tracks = {
	overworld : {
		bpm : 150, loops : 2, leadWidth : 0.5, harmWidth : 0.125, form : [ "A", "A", "B", "A" ],
		bass : "R . O . R . O . R . O . F . O .", drums : "k.h.s.h.k.h.s.h.", endDrums : "k.h.s.h.k.h.s.h.",
		phrases : {
			A : { chords : [ "C", "G", "Am", "F" ], melody : [
				"E5 - G5 - C6 - G5 - E5 - D5 E5 - - - .",
				"D5 - G5 - B5 - G5 - D5 - . - B4 - D5 -",
				"E5 - A5 - C6 - A5 - E5 - C5 - E5 - A5 -",
				"A5 - G5 - F5 - E5 - D5 - . - C5 - - -"
			] },
			B : { chords : [ "F", "G", "Em", "Am" ], melody : [
				"A5 - A5 - C6 - A5 - F5 - . - A5 - C6 -",
				"B5 - B5 - D6 - B5 - G5 - . - B5 - D6 -",
				"G5 - B5 - E6 - D6 - B5 - G5 - B5 - D6 -",
				"C6 - B5 - A5 - G5 - E5 - . - A5 - - -"
			] }
		}
	},
	cave : {
		bpm : 90, loops : 2, leadWidth : 0.125, harmWidth : 0.25, form : [ "A", "B" ], echo : true,
		bass : "R - - - - - - - - - - - F - - -", drums : "k.......s...h...", endDrums : "k.......s...h...",
		phrases : {
			A : { chords : [ "Am", "Am", "F", "E" ], melody : [
				"A4 - - - - - - - C5 - - - E5 - - -",
				"D5 - - - C5 - - - B4 - - - A4 - - -",
				"F5 - - - E5 - - - C5 - - - A4 - - -",
				"G##4 - - - B4 - - - E5 - - - - - - -"
			] },
			B : { chords : [ "Am", "F", "Dm", "E" ], melody : [
				"E5 - - - - - A5 - - - - - E5 - - -",
				"C6 - - - A5 - - - F5 - - - A5 - - -",
				"D5 - - - F5 - - - A5 - - - D6 - - -",
				"B5 - - - G##5 - - - E5 - - - - - . ."
			] }
		}
	},
	boss : {
		bpm : 170, loops : 2, leadWidth : 0.25, harmWidth : 0.125, form : [ "A", "A", "B", "A" ],
		bass : "R R O R R R O R R R O R F R O R", drums : "k.hksh.hk.hksh.s", endDrums : "k.hksh.hk.hksh.s",
		phrases : {
			A : { chords : [ "Dm", "Bb", "Gm", "A" ], melody : [
				"D5 D5 F5 D5 A5 D5 F5 D5 D5 D5 F5 A5 G5 F5 E5 D5",
				"Bb4 Bb4 D5 Bb4 F5 Bb4 D5 Bb4 Bb4 D5 F5 Bb5 A5 G5 F5 D5",
				"G4 G4 Bb4 G4 D5 G4 Bb4 G4 G4 Bb4 D5 G5 F5 E5 D5 Bb4",
				"A4 A4 C##5 A4 E5 A4 C##5 A4 E5 - A5 - G5 - E5 C##5"
			] },
			B : { chords : [ "Dm", "Dm", "Bb", "A" ], melody : [
				"A5 - - - D6 - - - C6 - Bb5 - A5 - - -",
				"F5 - - - A5 - - - G5 - F5 - E5 - - -",
				"D6 - - - F6 - - - E6 - D6 - Bb5 - - -",
				"A5 - G5 - F5 - E5 - D5 - E5 - A5 A5 A5 -"
			] }
		}
	},
	title : {
		bpm : 120, loops : 1, leadWidth : 0.5, harmWidth : 0.25, form : [ "A", "B" ],
		bass : "R - - - R - O - R - - - F - O -", drums : "k...s...k.k.s...", endDrums : "k...s...k.k.s...",
		phrases : {
			A : { chords : [ "G", "C", "D", "G" ], melody : [
				"G5 - - - B5 - - - D6 - - - D6 - - -",
				"E6 - D6 - C6 - - - B5 - - - A5 - - -",
				"F##5 - A5 - D6 - - - C6 - A5 - F##5 - - -",
				"G5 - - - B5 - D6 - G6 - - - - - - -"
			] },
			B : { chords : [ "Em", "C", "D", "G" ], melody : [
				"B5 - E6 - G6 - E6 - B5 - G5 - B5 - - -",
				"C6 - E6 - G6 - E6 - C6 - E6 - G6 - - -",
				"A5 - D6 - F##6 - D6 - A5 - F##5 - A5 - - -",
				"B5 - D6 - G6 - F##6 - E6 - D6 - B5 - - -"
			] }
		}
	},
	victory : {
		bpm : 140, loops : 1, leadWidth : 0.5, harmWidth : 0.125, form : [ "A", "B" ], finalBarHold : true,
		bass : "R . R . O . O . R . R . O . O .", drums : "k.h.s.h.k.h.s.hs", endDrums : "k...............",
		phrases : {
			A : { chords : [ "C", "F", "G", "C" ], melody : [
				"G5 - G5 - G5 - G5 - E5 - G5 - C6 - - -",
				"A5 - A5 - A5 - A5 - F5 - A5 - C6 - - -",
				"B5 - B5 - B5 - B5 - G5 - B5 - D6 - - -",
				"C6 - - - - - - - E6 - - - G6 - - -"
			] },
			B : { chords : [ "F", "G", "C", "C" ], melody : [
				"A5 - C6 - F6 - C6 - A5 - C6 - F6 - - -",
				"B5 - D6 - G6 - D6 - B5 - D6 - G6 - - -",
				"C6 - E6 - G6 - E6 - C7 - - - - - - -",
				"C7 - - - - - - - - - - - - - - -"
			] }
		}
	}
};

trackName = settings.track.lcase();
if( !tracks.keyExists( trackName ) ){
	throw( type = "bxaudio.example", message = "Unknown track [#settings.track#]. The tracks are: #tracks.keyArray().sort( 'text' ).toList( ', ' )#" );
}
track = tracks[ trackName ];
bpm = ( settings.bpm > 0 ? settings.bpm : track.bpm ) * 1.0;
loops = max( 1, int( settings.loops > 0 ? settings.loops : track.loops ) );
beat = 60 / bpm;
step = beat / 4;
outFile = settings.out.len() ? settings.out : "out/chiptune-" & trackName & ".wav";

// ---------------------------------------------------------------------------------------------------------------------------------
// Reading the notation
// ---------------------------------------------------------------------------------------------------------------------------------

/**
 * Turn a bar of 16 tokens into notes: [ { at : step in the bar, note : "C5", steps : length } ]. Fails loudly on a bar of the wrong length,
 * so a typo in the data cannot go unnoticed.
 */
function readBar( text, what ){
	var tokens = text.trim().reReplace( "\s+", " ", "all" ).listToArray( " " );
	if( tokens.len() != 16 ){
		throw( type = "bxaudio.example", message = "#what# has #tokens.len()# tokens, a bar needs 16: #text#" );
	}
	var notes = [];
	for( var i = 1; i <= 16; i++ ){
		var token = tokens[ i ];
		if( token == "-" ){
			if( notes.len() && notes.last().end == i - 1 ){
				notes.last().steps++;
				notes.last().end = i;
			}
		} else if( token != "." ){
			notes.append( { at : i - 1, note : token, steps : 1, end : i } );
		}
	}
	return notes;
}

pitchClass = { C : 0, "C##" : 1, Db : 1, D : 2, Eb : 3, E : 4, F : 5, "F##" : 6, Gb : 6, G : 7, Ab : 8, "G##" : 8, A : 9, Bb : 10, B : 11 };

/**
 * A chord name such as "C", "Am" or "Bb" as its root MIDI note (in the octave starting at `base`) and its three notes
 */
function chordNotes( name, base ){
	var minor = name.len() > 1 && name.right( 1 ) == "m";
	var root = base + pitchClass[ minor ? name.left( name.len() - 1 ) : name ];
	return { root : root, notes : [ root, root + ( minor ? 3 : 4 ), root + 7 ] };
}

// ---------------------------------------------------------------------------------------------------------------------------------
// The four channels
// ---------------------------------------------------------------------------------------------------------------------------------
pulseCache = {};
/**
 * A pulse wave note. `decay` is the time constant of its volume envelope: long for a held lead, short for a plucked arpeggio.
 */
function pulse( note, steps, width, decay ){
	var id = note & "|" & steps & "|" & width & "|" & decay;
	if( !pulseCache.keyExists( id ) ){
		var seconds = steps * step;
		var tone = audioOsc( shape = "pulse", freq = audioFreq( note ), seconds = seconds, sampleRate = sr, width = width );
		pulseCache[ id ] = audioFade( audioEnvelope( tone, 0.002, decay ), 0, min( 0.01, seconds / 2 ) );
	}
	return pulseCache[ id ];
}

triangleCache = {};
function triangle( note, steps ){
	var id = note & "|" & steps;
	if( !triangleCache.keyExists( id ) ){
		var seconds = steps * step;
		triangleCache[ id ] = audioFade( audioOsc( shape = "triangle", freq = audioFreq( note ), seconds = seconds, sampleRate = sr ), 0.002, min( 0.012, seconds / 2 ) );
	}
	return triangleCache[ id ];
}

// The noise channel: a kick (a fast falling pitch, which is how the triangle often did it), a snare and a hat
drumSounds = {
	k : audioEnvelope( audioSweep( 150, 45, 0.14 ), 0.001, 0.05 ),
	s : audioEnvelope( audioFilter( audioNoise( seconds = 0.12, sampleRate = sr, seed = 3, color = "white" ), "highpass", 1200, 0.7071 ), 0.001, 0.03 ),
	h : audioEnvelope( audioNoise( seconds = 0.05, sampleRate = sr, seed = 4, color = "blue" ), 0.001, 0.008 )
};
drumLevels = { k : -2, s : -7, h : -16 };

// ---------------------------------------------------------------------------------------------------------------------------------
// Building the arrangement
// ---------------------------------------------------------------------------------------------------------------------------------
function newVoice(){
	return audioTimeline( bpm = bpm, beatsPerBar = 4, sampleRate = sr, channels = 2 );
}
function put( voice, sound, at, pan, db ){
	audioAdd( timeline = voice, sound = sound, at = at, track = "main", db = db, pan = pan );
}

lead = newVoice();
harmony = newVoice();
bassVoice = newVoice();
noiseVoice = newVoice();

arpOrder = [ 1, 2, 3, 2 ];
bar = 0;
totalBars = track.form.len() * 4 * loops;
for( round = 1; round <= loops; round++ ){
	for( phraseName in track.form ){
		phrase = track.phrases[ phraseName ];
		for( b = 1; b <= 4; b++ ){
			t0 = bar * beat * 4;
			isFinal = ( bar == totalBars - 1 );
			chord = chordNotes( phrase.chords[ b ], 60 );
			low = chordNotes( phrase.chords[ b ], 36 );

			// Melody on the first pulse channel, on the left
			for( n in readBar( phrase.melody[ b ], "#trackName# phrase #phraseName# bar #b# melody" ) ){
				put( lead, pulse( n.note, n.steps, track.leadWidth, 0.7 ), t0 + n.at * step, -0.3, -5 );
			}

			// Arpeggio on the second pulse channel, on the right: the chord's notes, one per sixteenth, an octave up in the second half
			if( !( isFinal && track.keyExists( "finalBarHold" ) ) ){
				for( s = 0; s < 16; s++ ){
					midi = chord.notes[ arpOrder[ ( s mod 4 ) + 1 ] ] + ( s >= 8 ? 12 : 0 );
					put( harmony, pulse( midi, 1, track.harmWidth, 0.04 ), t0 + s * step, 0.3, -13 );
				}
			} else {
				// the last bar of a jingle holds the chord
				for( note in chord.notes ){
					put( harmony, pulse( note + 12, 12, track.harmWidth, 0.9 ), t0, 0.3, -12 );
				}
			}

			// Bass on the triangle channel
			bassTokens = track.bass.listToArray( " " );
			pos = 1;
			while( pos <= 16 ){
				token = bassTokens[ pos ];
				if( token != "." && token != "-" ){
					length = 1;
					while( pos + length <= 16 && bassTokens[ pos + length ] == "-" ){
						length++;
					}
					bassMidi = low.root + ( token == "O" ? 12 : ( token == "F" ? 7 : 0 ) );
					put( bassVoice, triangle( bassMidi, length ), t0 + ( pos - 1 ) * step, 0, -3 );
					pos += length;
				} else {
					pos++;
				}
			}

			// Drums on the noise channel, a different pattern for the very last bar of the track
			pattern = isFinal ? track.endDrums : track.drums;
			for( d = 1; d <= 16; d++ ){
				c = pattern.mid( d, 1 );
				if( c != "." ){
					put( noiseVoice, drumSounds[ c ], t0 + ( d - 1 ) * step, 0, drumLevels[ c ] );
				}
			}
			bar++;
		}
	}
}

// The cave track echoes its second pulse channel, a console could do that only by playing the notes again, which is what an echo is here
harmonyOut = audioRender( timeline = harmony, tail = 0.3 );
if( track.keyExists( "echo" ) ){
	harmonyOut = audioDelay( audio = harmonyOut, time = beat * 0.75, feedback = 0.4, mix = 0.35, pingPong = true );
}
mix = audioMix( [
	audioRender( timeline = lead, tail = 0.3 ),
	harmonyOut,
	audioRender( timeline = bassVoice, tail = 0.3 ),
	audioRender( timeline = noiseVoice, tail = 0.3 )
] );
mix = audioFilter( mix, "highpass", 30, 0.7071 );
mix = audioFade( mix, 0, 0.08, "smooth" );
mix = audioSaturate( mix, 1.2, 0.9 );
written = audioSave( mix, outFile );
println( "wrote " & written & " " & numberFormat( audioInfo( mix ).seconds, "0.0" ) & " s, " & trackName & " at " & bpm & " bpm, " & totalBars & " bars" );

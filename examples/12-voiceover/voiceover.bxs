/**
 * Voice-over: a trailer style announcement over music. The words are spoken by a text to speech voice, and the music, a pad, a pulsing
 * bass, an arpeggio and a light beat, ducks under the voice whenever it speaks and swells back between the lines. It is the mix you would
 * otherwise do by hand for a video: record the narration, put music under it, lower the music while someone talks.
 *
 * The voice needs the speech engine and the voice you choose, which download the first time (see docs/voices.md). To use a recording
 * of your own instead, pass `--voiceFile=narration.wav`.
 *
 * Usage:
 *   boxlang voiceover.bxs [--out=out/voiceover.wav] [--voice=kristin] [--speed=0.96] [--text="First line.|Second line.|Third line."]
 *                         [--voiceFile=narration.wav] [--duck=-12] [--bpm=100] [--install=false]
 */

settings = { out : "out/voiceover.wav", voice : "kristin", speed : 0.96, text : "", voiceFile : "", duck : -12, bpm : 100, install : true };
settings.append( cliGetArgs().options );
// Settings preset by whoever runs the script from code (tests, the bx-audio CLI) win over the command line
if( isDefined( "overrides" ) ){
	settings.append( overrides );
}

sr = 44100;
bpm = settings.bpm * 1.0;
beat = 60 / bpm;
bar = beat * 4;
step = beat / 4;

defaultLines = [
	"Welcome to BoxLang, a modern language for the JVM.",
	"It is fast to write, easy to read, and ready for anything.",
	"BoxLang. Build more, with less."
];

// ---------------------------------------------------------------------------------------------------------------------------------
// The voice: one clip per line, from the speech engine or from a file you supply
// ---------------------------------------------------------------------------------------------------------------------------------
clips = [];
if( settings.voiceFile.len() ){
	clips.append( audioLoad( settings.voiceFile ) );
} else {
	lines = settings.text.len() ? settings.text.listToArray( "|" ) : defaultLines;
	for( line in lines ){
		println( "speaking: " & line.trim() );
		clips.append( audioSpeak( text = line.trim(), voice = settings.voice, speed = settings.speed * 1.0, pauses = { sentence : 0.5, clause : 0.2 }, autoInstall = settings.install != false ) );
	}
}

/**
 * Bring a voice to a speaking level: -17 dBFS RMS, which is what keeps it clearly above the music, but never past -1 dBFS at the peak.
 * Speech has loud peaks and a low average, so levelling by the peak, as audioNormalize does, would leave it too quiet.
 */
function leveled( clip ){
	var info = audioInfo( clip );
	var gainDb = -17 - 20 * log10( max( info.rms, 0.0001 ) );
	var peakDb = 20 * log10( max( info.peak, 0.0001 ) );
	return audioGain( clip, min( gainDb, -1 - peakDb ) );
}
// A polished voice: no rumble, evened out by a gentle compressor, a touch of room, at a speaking level
clips = clips.map( ( clip ) => leveled( audioReverb( audio = audioCompress( audioFilter( clip, "highpass", 80, 0.7071 ), -22, 3, 12, 120 ), room = 0.2, damp = 0.6, mix = 0.05 ) ) );

// ---------------------------------------------------------------------------------------------------------------------------------
// Where each line goes: the first after two bars of music, each next one on a bar line after the last one ended
// ---------------------------------------------------------------------------------------------------------------------------------
starts = [];
cursor = 2 * bar;
for( clip in clips ){
	starts.append( cursor );
	cursor = ceiling( ( cursor + clip.getDurationSeconds() + beat ) / bar ) * bar;
}
voiceEnd = starts.last() + clips.last().getDurationSeconds();
bars = int( ceiling( voiceEnd / bar ) ) + 2;

// ---------------------------------------------------------------------------------------------------------------------------------
// The music: Am F C G
// ---------------------------------------------------------------------------------------------------------------------------------
chords = [
	{ bass : 33, notes : [ 57, 60, 64, 69 ] },
	{ bass : 29, notes : [ 53, 57, 60, 65 ] },
	{ bass : 36, notes : [ 55, 60, 64, 67 ] },
	{ bass : 31, notes : [ 55, 59, 62, 67 ] }
];

padCache = {};
function pad( index ){
	if( !padCache.keyExists( index ) ){
		var saws = [];
		for( var note in chords[ index ].notes ){
			saws.append( audioOsc( shape = "saw", freq = audioFreq( note - 0.15 ), seconds = bar + 1.2, sampleRate = sr, harmonics = 12 ) );
			saws.append( audioOsc( shape = "saw", freq = audioFreq( note + 0.15 ), seconds = bar + 1.2, sampleRate = sr, harmonics = 12 ) );
		}
		padCache[ index ] = audioGain( audioFilter( audioEnvelope( audioMix( saws ), 0.4, 4 ), "lowpass", 2000, 0.8 ), -13 );
	}
	return padCache[ index ];
}
bassCache = {};
function bassNote( midi ){
	if( !bassCache.keyExists( midi ) ){
		bassCache[ midi ] = audioEnvelope( audioFilter( audioOsc( shape = "saw", freq = audioFreq( midi ), seconds = 0.4, sampleRate = sr, harmonics = 16 ), "lowpass", 600, 1.4 ), 0.004, 0.16 );
	}
	return bassCache[ midi ];
}
pluckCache = {};
function pluck( midi ){
	if( !pluckCache.keyExists( midi ) ){
		pluckCache[ midi ] = audioFilter( audioEnvelope( audioOsc( shape = "square", freq = audioFreq( midi ), seconds = 0.25, sampleRate = sr, harmonics = 12 ), 0.002, 0.07 ), "lowpass", 4500, 1.0 );
	}
	return pluckCache[ midi ];
}
kick = audioDrum( type = "kick", pitch = 1.0, decay = 0.8, level = 0.9 );
hat = audioDrum( type = "hat", seed = 5, level = 0.4 );
crash = audioDrum( type = "crash", seed = 6, decay = 1.4, level = 0.6 );

t = audioTimeline( bpm = bpm, beatsPerBar = 4, sampleRate = sr, channels = 2 );
arp = [ 1, 2, 3, 4, 3, 2, 3, 4 ];
for( b = 0; b < bars; b++ ){
	t0 = b * bar;
	index = ( b mod 4 ) + 1;
	isLast = ( b == bars - 1 );
	audioAdd( timeline = t, sound = pad( index ), at = t0, track = "music", db = -2 );
	if( isLast ){
		audioAdd( timeline = t, sound = crash, at = t0, track = "drums", db = -4 );
		audioAdd( timeline = t, sound = kick, at = t0, track = "drums", db = -3 );
		continue;
	}
	// arpeggio from the start, the bass and beat from bar two
	for( s = 0; s < 16; s += 2 ){
		audioAdd( timeline = t, sound = pluck( chords[ index ].notes[ arp[ ( s / 2 ) mod 8 + 1 ] ] + 12 ), at = t0 + s * step, track = "music", db = s mod 4 == 0 ? -12 : -16,
			pan = s mod 4 == 0 ? -0.3 : 0.3 );
	}
	if( b >= 2 ){
		for( s = 0; s < 8; s++ ){
			audioAdd( timeline = t, sound = bassNote( chords[ index ].bass ), at = t0 + s * beat / 2, track = "music", db = s mod 2 == 0 ? -4 : -7 );
		}
		for( k = 0; k < 4; k++ ){
			audioAdd( timeline = t, sound = kick, at = t0 + k * beat, track = "drums", db = -5 );
			audioAdd( timeline = t, sound = hat, at = t0 + k * beat + beat / 2, track = "drums", db = -17, pan = 0.2 );
		}
	}
}

// ---------------------------------------------------------------------------------------------------------------------------------
// The voice goes on its own track, in the middle, and the music and the beat duck under it
// ---------------------------------------------------------------------------------------------------------------------------------
for( i = 1; i <= clips.len(); i++ ){
	audioAdd( timeline = t, sound = clips[ i ], at = starts[ i ], track = "voice", db = 0 );
}
// The music and the beat sit below the voice even when it is silent, and duck further while it speaks
audioTrackGain( t, "music", -10 );
audioTrackGain( t, "drums", -10 );
audioDuck( t, "music", "voice", settings.duck );
audioDuck( t, "drums", "voice", settings.duck );

mix = audioRender( timeline = t, tail = 3 );
mix = audioFade( mix, 0.05, 1.5, "smooth" );
mix = audioSaturate( mix, 1.4, 0.9 );
written = audioSave( mix, settings.out );
println( "wrote " & written & " " & numberFormat( audioInfo( mix ).seconds, "0.0" ) & " s, " & clips.len() & " line" & ( clips.len() > 1 ? "s" : "" ) & " of voice-over, " & bars & " bars at " & bpm & " bpm" );

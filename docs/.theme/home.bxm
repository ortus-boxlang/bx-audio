<!---
	The BxAudio landing page. Based on the bx-sites bootstrap home.bxm: the head, header and footer machinery are the theme, the content and
	the look (audio-home.css, audio-home.js) are ours. The outer shell for the site's own homepage (`docs/index.md`'s own
	`layout: home` frontmatter) - selected in place of `layout.bxm` via
	ThemeRenderer.renderPage()'s own `layoutHint` (BuildPipeline.bx's
	renderDocTree() forwards every page's own `page.layout` as the
	layoutHint, so any page can opt into an alternate outer shell this way,
	not just the blog). Unlike `blog.bxm`, this is NOT a close derivative of
	`layout.bxm` - there's no sidebar, no TOC rail, and the header is a
	horizontal marketing nav instead of the docs hamburger/sidebar toggle.
	It never includes `#variables.bodyFile#` - the whole page is hardcoded
	here, so `docs/index.md`'s own Markdown body is unused when this layout
	renders it.
--->
<bx:include template="#variables.moduleAssetsDir#/icons.bxm">
<bx:include template="#variables.moduleAssetsDir#/locale-flags.bxm">
<bx:include template="includes/site-helpers.bxm">
<bx:script>
	// module spec section 7 - search is fully static/client-side (provider "local") by
	// default, opt-out via bxsites.json's `search`; `searchProvider.provider` picks a
	// different provider ("algolia"/"pagefind" built-in here, anything else left to a theme override)
	variables.searchEnabled = ( variables.siteConfig.search ?: false ) ? true : false
	variables.searchProviderName = lCase( trim( variables.siteConfig.searchProvider.provider ?: "local" ) )
	variables.searchAlgolia = variables.siteConfig.searchProvider.algolia ?: {}

	variables.repoUrl = trim( variables.siteConfig.repo.url ?: "" )
	variables.socialLinks = variables.siteConfig.social ?: []
	variables.footerEnabled = ( variables.siteConfig.footer ?: false ) ? true : false
	variables.navCollapsible = ( variables.siteConfig.theme.options.navCollapsible ?: false ) ? true : false
	variables.navExpandAll = ( variables.siteConfig.theme.options.navExpandAll ?: true ) ? true : false
	variables.tocPosition = variables.siteConfig.theme.options.tocPosition ?: "top"
	variables.mainContentClass = variables.tocPosition == "sticky" ? "col-xl-8" : "col-xl-10"
	variables.pageMetaPosition = variables.siteConfig.theme.options.pageMetaPosition ?: "bottom"
	variables.breadcrumbsEnabled = ( variables.siteConfig.theme.options.breadcrumbs ?: true ) ? true : false
	variables.faviconUrl = trim( variables.siteConfig.theme.favicon ?: "" )
	variables.ogImageUrl = len( trim( variables.page.ogImage ?: "" ) ) ? trim( variables.page.ogImage ) : trim( variables.siteConfig.ogImage ?: "" )
	variables.ogDescription = len( variables.page.description ?: "" ) ? variables.page.description : ( variables.siteConfig.description ?: "" )
	variables.analyticsProvider = trim( variables.siteConfig.analytics.provider ?: "" )
	variables.analyticsId = trim( variables.siteConfig.analytics.id ?: "" )
	variables.mermaidEnabled = ( variables.siteConfig.mermaid ?: false ) ? true : false
	variables.mathEnabled = ( variables.siteConfig.math ?: false ) ? true : false
	variables.openapiEnabled = ( variables.siteConfig.openapi ?: false ) ? true : false
	variables.pageActionsEnabled = ( variables.siteConfig.pageActions ?: false ) ? true : false
	variables.pageActionsPosition = variables.siteConfig.theme.options.pageActionsPosition ?: "top"
	variables.accentColor = trim( variables.siteConfig.theme.options.accentColor ?: "" )
	variables.accentColorDark = trim( variables.siteConfig.theme.options.accentColorDark ?: "" )
</bx:script>
<bx:output>
<!doctype html>
<html lang="#encodeForHTML( variables.currentLocale.len() ? variables.currentLocale : 'en' )#" dir="#encodeForHTML( variables.currentLocaleDir )#">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>BxAudio: Make, Mix, Master and Speak Audio from BoxLang</title>
	<meta property="og:type" content="#encodeForHTML( len( trim( variables.page.ogType ?: '' ) ) ? variables.page.ogType : 'website' )#">
	<meta property="og:site_name" content="#encodeForHTML( variables.siteConfig.name )#">
	<meta property="og:title" content="BxAudio: Make, Mix, Master and Speak Audio from BoxLang">
	<meta property="og:url" content="https://bxaudio.boxlang.io/">

	<!--- Open Graph and meta tags for SEO --->
	#renderArticleMeta()#

	<!--- Canonical URL --->
	<bx:if len( variables.page.canonicalUrl )>
		<link rel="canonical" href="#encodeForHTML( variables.page.canonicalUrl )#">
	</bx:if>

	<!--- Meta description and Open Graph description --->
	<bx:if len( variables.ogDescription )>
		<meta name="description" content="#encodeForHTML( variables.ogDescription )#">
		<meta property="og:description" content="#encodeForHTML( variables.ogDescription )#">
	</bx:if>

	<!--- Open Graph image and Twitter card --->
	<bx:if len( variables.ogImageUrl )>
		<meta property="og:image" content="#resolveAssetUrl( variables.ogImageUrl )#">
		<meta name="twitter:card" content="summary_large_image">
	</bx:if>

	<!--- Favicon --->
	<bx:if len( variables.faviconUrl )>
		<link rel="icon" href="#resolveAssetUrl( variables.faviconUrl )#">
	</bx:if>

	<!--- Color mode detection (before CSS, to avoid flash) --->
	<script>
		( function () {
			var configuredMode = "#variables.siteConfig.theme.options.colorMode ?: 'auto'#";
			var stored = localStorage.getItem( "bxsites-theme" );
			var prefersDark = window.matchMedia( "(prefers-color-scheme: dark)" ).matches;
			var wantsDark = stored ? stored === "dark" : ( configuredMode === "dark" || ( configuredMode === "auto" && prefersDark ) );
			if ( wantsDark ) {
				document.documentElement.setAttribute( "data-theme", "dark" );
			}
		} )();
	</script>

	<!--- Base CSS and theme CSS (+ the homepage-only stylesheet) --->
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/bootstrap/bootstrap.min.css">
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/highlight/github.min.css">
	<link rel="stylesheet" href="#themeAssetUrl( 'style.css' )#">
	<link rel="stylesheet" href="#moduleAssetUrl( 'home.css' )#">
	<link rel="stylesheet" href="#variables.basePath#assets/vendor/phosphor/style.css">
	<link rel="stylesheet" href="#themeAssetUrl( 'audio-home.css' )#">

	<!--- Extra CSS --->
	#renderExtraCss( variables.siteConfig.extraCss ?: [] )#

	<!--- Accent color overrides --->
	<bx:if len( variables.accentColor ) or len( variables.accentColorDark )>
		<style>
			<!--- Light mode accent color --->
			<bx:if len( variables.accentColor )>
				:root {
					--bxsites-accent: #variables.accentColor#;
					--bxsites-link: #variables.accentColor#;
					--bxsites-link-hover: color-mix( in srgb, #variables.accentColor# 85%, black );
				}
			</bx:if>
			<!--- Dark mode accent color --->
			<bx:if len( variables.accentColorDark )>
				[data-theme="dark"] {
					--bxsites-accent: #variables.accentColorDark#;
					--bxsites-link: #variables.accentColorDark#;
					--bxsites-link-hover: color-mix( in srgb, #variables.accentColorDark# 85%, white );
				}
			</bx:if>
		</style>
	</bx:if>

	<!--- Math CSS --->
	<bx:if variables.mathEnabled>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css">
	</bx:if>

	<!--- OpenAPI CSS --->
	<bx:if variables.openapiEnabled>
		<link rel="stylesheet" href="#variables.basePath#assets/vendor/swagger-ui/swagger-ui.css">
	</bx:if>

	<!--- Google Analytics --->
	<bx:if variables.analyticsProvider == 'google'>
		<script async src="https://www.googletagmanager.com/gtag/js?id=#encodeForHTML( variables.analyticsId )#"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', '#variables.analyticsId#');
		</script>
	</bx:if>

	<!--- Local search CSS and JS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'local'>
		<script>window.__BXSITES_BASE_PATH__ = "#variables.basePath#";</script>
		<script>window.__BXSITES_SEARCH_NO_RESULTS__ = "#encodeForJavaScript( variables.strings.searchNoResults )#";</script>
		<script src="#variables.basePath#assets/vendor/minisearch/minisearch.js"></script>
		<script src="#moduleAssetUrl( 'search.js' )#" defer></script>
	</bx:if>

	<!--- Algolia search CSS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'algolia'>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@docsearch/css@3">
	</bx:if>

	<!--- Pagefind search CSS --->
	<bx:if variables.searchEnabled and variables.searchProviderName eq 'pagefind'>
		<link rel="stylesheet" href="#variables.basePath#pagefind/pagefind-ui.css">
	</bx:if>

	<!--- Alpine JS --->
	<script src="#variables.basePath#assets/vendor/alpine/cdn.min.js" defer></script>
</head>
<body
	class="bxsites-home"
	x-data="{ dark: document.documentElement.getAttribute( 'data-theme' ) === 'dark' }"
	x-init="$watch( 'dark', v => { document.documentElement.setAttribute( 'data-theme', v ? 'dark' : 'light' ); localStorage.setItem( 'bxsites-theme', v ? 'dark' : 'light' ) } )">

	<!--- Header: horizontal marketing nav --->
	<header class="bxh-nav">
		<div class="bxh-wrap bxh-navrow">
			<a class="bxh-brand" href="#variables.basePath#">#renderBrandMark()#</a>
			<nav class="bxh-navlinks">
				<a href="#variables.basePath#getting-started/">Get started</a>
				<a href="#variables.basePath#try-it/">Try it</a>
				<a href="#variables.basePath#examples/">Examples</a>
				<a href="#variables.basePath#guides/">Guides</a>
				<a href="#variables.basePath#reference/functions/">Reference</a>
				<a href="#variables.basePath#voices/">Voices</a>
			</nav>
			<div class="bxh-navcta">
				<div class="bxh-search">
					<bx:if variables.searchEnabled>
						<bx:include template="#variables.themeDir#/search.bxm">
					</bx:if>
				</div>
				<div class="bxh-nav-utils">
					<button type="button" class="bxh-theme-toggle" @click="dark = !dark" aria-label="#encodeForHTML( variables.strings.toggleDarkMode )#">
						<span x-show="!dark">#bxsitesIcon( "moon" )#</span>
						<span x-show="dark" x-cloak>#bxsitesIcon( "sun" )#</span>
					</button>
				</div>
				<bx:if len( variables.repoUrl )>
					<a class="bxh-btn bxh-btn-ghost bxh-btn-sm" href="#bxsitesUrlAttr( variables.repoUrl )#" target="_blank" rel="noopener noreferrer">#bxsitesIcon( "github" )# Star</a>
				</bx:if>
			</div>
		</div>
	</header>

	<!--- Hero --->
	<main class="ax-hero">
		<div class="ax-aurora" aria-hidden="true"></div>
		<div class="ax-notes" id="ax-notes" aria-hidden="true"></div>
		<div class="bxh-wrap ax-hero-grid">
			<div class="ax-hero-copy">
				<span class="eyebrow"><i class="ph-duotone ph-music-notes"></i> A BoxLang module &middot; pure JVM</span>
				<h1>Make a <span class="grad ax-swap" id="ax-swap">kick</span> from code. Master it. Make it speak.</h1>
				<p class="lead">Synthesize instruments and drums, arrange them on a beat grid, master to a loudness target, speak text with <strong>open license voices</strong>, score a video and play sound in a game. <strong>No Python. Nothing native to install.</strong></p>
				<div class="ax-install"><span class="prompt">$</span><code>install-bx-module bx-audio</code><button type="button" id="ax-copy" aria-label="Copy the install command">Copy</button></div>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get started <i class="ph-duotone ph-arrow-right"></i></a>
					<a class="bxh-btn bxh-btn-ghost" href="##ax-playground"><i class="ph-duotone ph-sliders-horizontal"></i> Try it in your browser</a>
				</div>
				<ul class="ax-trust">
					<li><b>83</b> functions</li>
					<li><b>EBU R128</b> mastering</li>
					<li><b>11</b> open voices</li>
					<li><b>16</b> pieces made from code</li>
				</ul>
			</div>

			<div class="ax-stage" id="ax-stage">
				<div class="ax-stage-bar"><i class="dot"></i><i class="dot"></i><i class="dot"></i><span>theme.bxs</span></div>
<pre class="ax-code"><span class="c">// The hero motif: rising fourths, then a dotted turn</span>
<span class="n">motif</span> = [ [ <span class="n">0</span>, <span class="n">69</span>, <span class="n">4</span> ], [ <span class="n">4</span>, <span class="n">74</span>, <span class="n">6</span> ], [ <span class="n">10</span>, <span class="n">76</span>, <span class="n">2</span> ], [ <span class="n">12</span>, <span class="n">78</span>, <span class="n">4</span> ] ];
<span class="k">for</span>( <span class="n">n</span> <span class="k">in</span> motif ){
    <span class="n">note</span> = <span class="f">leadNote</span>( n[ <span class="n">2</span> ], n[ <span class="n">3</span> ] );
    <span class="f">audioAdd</span>( timeline=lead, sound=note, at=n[ <span class="n">1</span> ] * step );
}
<span class="n">bass</span> = <span class="f">audioFilter</span>(
    <span class="f">audioOsc</span>( <span class="s">"saw"</span>, <span class="f">audioFreq</span>( <span class="n">38</span> ), <span class="n">0.3</span> ), <span class="s">"lowpass"</span>, <span class="n">900</span>, <span class="n">2.4</span> );
<span class="n">mix</span> = <span class="f">audioMix</span>( [ drums, bass, pads, arp, lead, harp ] );
<span class="n">mix</span> = <span class="f">audioMaster</span>( audio=mix, target=<span class="s">"streaming"</span> );  <span class="c">// -14 LUFS</span>
<span class="f">audioSave</span>( mix, <span class="s">"theme.mp3"</span> );</pre>
				<div class="ax-player" id="ax-hero-player">
					<button type="button" class="ax-play" id="ax-hero-btn" data-src="#variables.basePath#assets/audio/theme.mp3" aria-label="Play the BxAudio theme"><i class="ph-duotone ph-play"></i></button>
					<div class="ax-wave" id="ax-wave" aria-hidden="true"></div>
					<div class="ax-meta"><span>Press play for <b>the BxAudio theme</b>, made by <code>examples/15-theme</code></span><span class="pill">-14 LUFS</span></div>
				</div>
				<div class="ax-seq" id="ax-seq" aria-hidden="true">
					<div class="ax-seq-label"><span><i class="ph-duotone ph-metronome"></i> 16 step grid</span><span>132 BPM</span></div>
				</div>
			</div>
		</div>
	</main>

	<div class="ax-marquee" aria-hidden="true"><div class="ax-track" id="ax-track"></div></div>

	<!--- Listen strip --->
	<section class="ax-listen" id="listen">
		<div class="bxh-wrap">
			<div class="section-head ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-headphones"></i> Press play</span>
				<h2>Every one of these was <span class="grad">written, not recorded</span>.</h2>
				<p>Sixteen complete pieces rendered by the module from a few dozen lines each. Nothing plays until you press a button.</p>
			</div>
			<div class="ax-clips" id="ax-clips" data-base="#variables.basePath#assets/audio/"></div>
		</div>
	</section>

	<!--- Features --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-cpu"></i> Everything on the JVM</span>
				<h2>One module. The whole <span class="grad">audio pipeline</span>.</h2>
			</div>
			<div class="ax-cards">
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/synthesis-and-effects/"><div class="ico"><i class="ph-duotone ph-piano-keys"></i></div><h3>Synthesis and mixing</h3><p>Band-limited oscillators, drums, filters, a tempo grid, named tracks and kick pumping.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/speech-and-subtitles/"><div class="ico"><i class="ph-duotone ph-microphone-stage"></i></div><h3>Text to speech</h3><p>Open license voices that download on first use, with speed, pauses and captions timed to the words.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/trailers-and-video/"><div class="ico"><i class="ph-duotone ph-film-strip"></i></div><h3>Score a video</h3><p>Cut music to the exact length of a picture, add a voice-over and mux it with FFmpeg. <code>audioMux()</code></p></a>
				<a class="ax-card ax-wide ax-reveal" href="#variables.basePath#guides/loudness-and-mastering/">
					<div><div class="ico"><i class="ph-duotone ph-gauge"></i></div><h3>Loudness and mastering</h3><p>Measure the EBU R128 way and deliver to a target with a mastering chain, compressor, limiter and EQ.</p></div>
					<div class="ax-meter">
						<div><em>Streaming</em><span><i style="--w:72%"></i></span><b>-14 LUFS</b></div>
						<div><em>Podcast</em><span><i style="--w:66%"></i></span><b>-16 LUFS</b></div>
						<div><em>Broadcast</em><span><i style="--w:60%"></i></span><b>-23 LUFS</b></div>
					</div>
				</a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/games/"><div class="ico"><i class="ph-duotone ph-game-controller"></i></div><h3>Game audio</h3><p>A real time mixer with buses, loops and crossfades, varied effects and audio sprites.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/time-and-pitch/"><div class="ico"><i class="ph-duotone ph-metronome"></i></div><h3>Time and pitch</h3><p>Stretch, pitch shift and fit a clip to an exact length without the chipmunk.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/analysis/"><div class="ico"><i class="ph-duotone ph-chart-bar"></i></div><h3>Analysis</h3><p>FFT, spectrum, tempo and silence detection, plus true peak.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/modulation-and-automation/"><div class="ico"><i class="ph-duotone ph-wave-sine"></i></div><h3>Modulation and real rooms</h3><p>LFOs, curves, automation lanes, a sampler that plays your recordings as instruments, and convolution reverb.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/podcasts/"><div class="ico"><i class="ph-duotone ph-tag"></i></div><h3>Tags, chapters and cover art</h3><p>Read and write ID3, FLAC and WAV tags, chapter marks and artwork without any native library.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#guides/web-apps/"><div class="ico"><i class="ph-duotone ph-globe-hemisphere-west"></i></div><h3>Web delivery and pictures</h3><p>Serve audio with Range and ETag support, encode to bytes, and draw waveforms and spectrograms as PNG or SVG.</p></a>
				<a class="ax-card ax-reveal" href="#variables.basePath#reference/cli/"><div class="ico"><i class="ph-duotone ph-terminal-window"></i></div><h3>A real command line</h3><p><code>bx-audio info</code>, <code>master</code>, <code>speak</code> and more. Downloads live in <code>~/.bxaudio</code>.</p></a>
			</div>
		</div>
	</section>

	<div class="ax-waves" aria-hidden="true">
		<svg viewBox="0 0 1440 90" preserveAspectRatio="none"><defs><linearGradient id="axwg" x1="0" x2="1"><stop offset="0" stop-color="##00efd0"/><stop offset=".55" stop-color="##00d4ef"/><stop offset="1" stop-color="##0074ff"/></linearGradient></defs><path class="a" d="M-100 45 Q -55 5 -10 45 T 80 45 T 170 45 T 260 45 T 350 45 T 440 45 T 530 45 T 620 45 T 710 45 T 800 45 T 890 45 T 980 45 T 1070 45 T 1160 45 T 1250 45 T 1340 45 T 1430 45 T 1520 45"/><path class="b" d="M-100 45 Q -55 80 -10 45 T 80 45 T 170 45 T 260 45 T 350 45 T 440 45 T 530 45 T 620 45 T 710 45 T 800 45 T 890 45 T 980 45 T 1070 45 T 1160 45 T 1250 45 T 1340 45 T 1430 45 T 1520 45"/></svg>
	</div>

	<!--- Playground --->
	<section id="ax-playground">
		<div class="bxh-wrap">
			<div class="section-head ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-sliders-horizontal"></i> Try it in your browser</span>
				<h2>Turn the knobs. <span class="grad">Hear the idea.</span></h2>
				<p>A quick preview of four building blocks, played by your browser. The module renders the real thing offline on the JVM, so it sounds the same on every machine.</p>
			</div>
			<div class="ax-pg ax-reveal" id="ax-pg">
				<div class="ax-pg-tabs" role="tablist">
					<button type="button" role="tab" class="on" data-recipe="kick"><i class="ph-duotone ph-vinyl-record"></i> Kick</button>
					<button type="button" role="tab" data-recipe="bass"><i class="ph-duotone ph-waveform"></i> Bass</button>
					<button type="button" role="tab" data-recipe="arp"><i class="ph-duotone ph-piano-keys"></i> Arpeggio</button>
					<button type="button" role="tab" data-recipe="chime"><i class="ph-duotone ph-bell-ringing"></i> Chime</button>
				</div>
				<div class="ax-pg-body">
					<div class="ax-pg-controls">
						<div id="ax-pg-sliders"></div>
						<button type="button" class="bxh-btn bxh-btn-primary ax-pg-play" id="ax-pg-play"><i class="ph-duotone ph-play"></i> Play</button>
					</div>
					<div class="ax-pg-code">
						<div class="ax-pg-code-bar"><span>BoxLang</span><button type="button" id="ax-pg-copy"><i class="ph-duotone ph-copy"></i> Copy</button></div>
<pre id="ax-pg-snippet"></pre>
					</div>
				</div>
				<div class="ax-pg-foot"><i class="ph-duotone ph-info"></i> <span>Want the real module? <a href="#variables.basePath#try-it/">Clone it and run every feature</a>.</span></div>
			</div>
		</div>
	</section>

	<!--- Voices and licenses --->
	<div class="ax-piano" id="ax-piano" aria-hidden="true"></div>
	<section class="ax-voices" id="voices">
		<div class="bxh-wrap ax-vgrid">
			<div class="ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-scales"></i> Voices and licenses</span>
				<h2>Voices with the <span class="grad">paperwork done</span>.</h2>
				<p>We read the license of every voice in the collection and of the data it was trained on. The ones offered carry an open license that allows commercial use (CC0, Public Domain, Apache-2.0, or CC BY and CC BY-SA with a credit), and <code>audioCredits()</code> prints the credit lines for your about page. The rest are listed with the reason they are not. Today the voices speak US English; Spanish, German, Italian, French and Portuguese are planned.</p>
				<div class="ax-big"><div><b class="grad">177</b><small>voices reviewed</small></div><div><b class="grad">11</b><small>offered</small></div><div><b>166</b><small>left out, with reasons</small></div></div>
				<div class="hero-actions"><a class="bxh-btn bxh-btn-ghost" href="#variables.basePath#licenses/">Read the license guide <i class="ph-duotone ph-arrow-right"></i></a></div>
			</div>
			<div class="ax-lic ax-reveal"><table>
				<tr><th>Voice</th><th>License</th><th>Status</th><th></th></tr>
				<tr><td>en_US joe</td><td>CC0</td><td><span class="ax-tag ok">Offered</span></td><td><button type="button" class="ax-vplay" data-src="#variables.basePath#assets/audio/voices/en_US-joe-medium.mp3" aria-label="Play en_US joe"><i class="ph-duotone ph-play"></i></button></td></tr>
				<tr><td>en_US bryce</td><td>Public Domain</td><td><span class="ax-tag ok">Offered</span></td><td><button type="button" class="ax-vplay" data-src="#variables.basePath#assets/audio/voices/en_US-bryce-medium.mp3" aria-label="Play en_US bryce"><i class="ph-duotone ph-play"></i></button></td></tr>
				<tr><td>en_US kristin</td><td>Public Domain</td><td><span class="ax-tag ok">Offered</span></td><td><button type="button" class="ax-vplay" data-src="#variables.basePath#assets/audio/voices/en_US-kristin-medium.mp3" aria-label="Play en_US kristin"><i class="ph-duotone ph-play"></i></button></td></tr>
				<tr><td>en_GB (dictionary)</td><td>GPL data</td><td><span class="ax-tag no">Not offered</span></td><td></td></tr>
				<tr><td>Non-commercial set</td><td>CC BY-NC</td><td><span class="ax-tag no">Not offered</span></td><td></td></tr>
			</table></div>
		</div>
	</section>

	<!--- Ecosystem --->
	<section>
		<div class="bxh-wrap">
			<div class="section-head ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-graph"></i> Part of the BoxLang ecosystem</span>
				<h2>Built for <span class="grad">BoxLang</span>, with <span class="grad">BoxLang</span>.</h2>
			</div>
			<div class="ax-eco">
				<a class="ax-reveal" style="--d:0s" href="https://boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/boxlang-icon-full.svg" alt="BoxLang"></div><b>BoxLang <i class="ph-duotone ph-arrow-up-right"></i></b><span>The dynamic JVM language this module is built for.</span></a>
				<a class="ax-reveal" style="--d:.05s" href="https://ai.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/icon-module-bx-ai.svg" alt="BoxLang AI"></div><b>BoxLang AI <i class="ph-duotone ph-arrow-up-right"></i></b><span>Generate scripts and narration text, then render them with Audio.</span></a>
				<a class="ax-reveal" style="--d:.1s" href="https://boxlang.io/plans" target="_blank" rel="noopener noreferrer"><div class="ic ph"><i class="ph-duotone ph-seal-check"></i></div><b>BoxLang+ <i class="ph-duotone ph-arrow-up-right"></i></b><span>Support, modules and the features that run a fleet.</span></a>
				<a class="ax-reveal" style="--d:.15s" href="https://www.coldbox.org" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/coldbox-icon-full.svg" alt="ColdBox"></div><b>ColdBox <i class="ph-duotone ph-arrow-up-right"></i></b><span>Serve generated audio from the apps you build on ColdBox.</span></a>
				<a class="ax-reveal" style="--d:.2s" href="https://commandbox.ortusbooks.com" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/commandbox-icon-full.svg" alt="CommandBox"></div><b>CommandBox <i class="ph-duotone ph-arrow-up-right"></i></b><span>Install the module and its command line from the package manager.</span></a>
				<a class="ax-reveal" style="--d:.25s" href="https://bxsites.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxsites-icon-full.svg" alt="bxSites"></div><b>bxSites <i class="ph-duotone ph-arrow-up-right"></i></b><span>The static site generator that builds these docs.</span></a>
				<a class="ax-reveal" style="--d:.3s" href="https://bxplaywright.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxplaywright-icon-full.svg" alt="BxPlaywright"></div><b>BxPlaywright <i class="ph-duotone ph-arrow-up-right"></i></b><span>Browser automation and testing for BoxLang.</span></a>
				<a class="ax-reveal" style="--d:.35s" href="https://bxlens.boxlang.io" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxlens-icon-full.svg" alt="BxLens"></div><b>BxLens <i class="ph-duotone ph-arrow-up-right"></i></b><span>The debug bar and ops console for BoxLang apps.</span></a>
				<a class="ax-reveal" style="--d:.4s" href="https://bxagents.ai" target="_blank" rel="noopener noreferrer"><div class="ic"><img src="#variables.basePath#assets/ecosystem/bxagents-icon-full.svg" alt="BxAgents"></div><b>BxAgents <i class="ph-duotone ph-arrow-up-right"></i></b><span>Build AI agents by convention, powered by BoxLang AI.</span></a>
			</div>
		</div>
	</section>

	<!--- Consulting and support --->
	<section class="ax-tight">
		<div class="bxh-wrap">
			<div class="ax-support ax-reveal">
				<div class="l">
					<span class="eyebrow"><i class="ph-duotone ph-handshake"></i> Consulting and support</span>
					<h2>Need audio in production? <span class="grad">Talk to the people who build BoxLang.</span></h2>
					<p><a href="https://www.ortussolutions.com" target="_blank" rel="noopener noreferrer">Ortus Solutions</a> offers professional support, architecture reviews and custom development for BoxLang, including audio pipelines, narration and video workflows.</p>
					<div class="hero-actions">
						<a class="bxh-btn bxh-btn-primary" href="https://www.ortussolutions.com/services" target="_blank" rel="noopener noreferrer">Talk to Ortus <i class="ph-duotone ph-arrow-right"></i></a>
						<a class="bxh-btn bxh-btn-ghost" href="https://boxlang.io/plans" target="_blank" rel="noopener noreferrer">See BoxLang+ plans</a>
						<a class="bxh-btn bxh-btn-ghost" href="mailto:consulting@ortussolutions.com"><i class="ph-duotone ph-envelope-simple"></i> consulting@ortussolutions.com</a>
					</div>
				</div>
				<div class="r">
					<div class="perk"><span class="pi"><i class="ph-duotone ph-headset"></i></span><div><b>Priority support</b><span>Answers from the team that wrote the runtime.</span></div></div>
					<div class="perk"><span class="pi"><i class="ph-duotone ph-wrench"></i></span><div><b>Custom development</b><span>Voices, pipelines and integrations built to your brief.</span></div></div>
					<div class="perk"><span class="pi"><i class="ph-duotone ph-graduation-cap"></i></span><div><b>Training and review</b><span>Get your team productive and your design checked.</span></div></div>
				</div>
			</div>
		</div>
	</section>

	<!--- Final CTA --->
	<section class="ax-tight">
		<div class="bxh-wrap">
			<div class="cta ax-reveal">
				<span class="eyebrow"><i class="ph-duotone ph-timer"></i> Two minutes to your first sound</span>
				<h2>Install it. Run one line. <span class="grad">Hear it.</span></h2>
				<p>Install the module and render your first beat from a script.</p>
				<div class="hero-actions">
					<a class="bxh-btn bxh-btn-primary" href="#variables.basePath#getting-started/">Get started <i class="ph-duotone ph-arrow-right"></i></a>
					<a class="bxh-btn bxh-btn-ghost" href="#variables.basePath#try-it/">Try every feature</a>
				</div>
			</div>
		</div>
	</section>

	<!--- Footer --->
	<footer class="bxh-footer">
		<div class="bxh-wrap footer-top">
			<div class="footer-brand">
				<a class="bxh-brand" href="#variables.basePath#">#renderBrandMark()#</a>
				<p>Make, mix, master and speak audio from BoxLang, on the JVM.</p>
				<bx:if variables.socialLinks.len() gt 0>
					<div class="social-row">#renderSocialLinks( variables.socialLinks )#</div>
				</bx:if>
				<div class="madeby"><span>Developed by</span> Ortus Solutions</div>
			</div>
			<div class="footer-col">
				<h4>Learn</h4>
				<a href="#variables.basePath#getting-started/">Getting started</a>
				<a href="#variables.basePath#try-it/">Try it</a>
				<a href="#variables.basePath#guides/">Guides</a>
				<a href="#variables.basePath#examples/">Examples</a>
			</div>
			<div class="footer-col">
				<h4>Reference</h4>
				<a href="#variables.basePath#reference/functions/">Functions</a>
				<a href="#variables.basePath#reference/cli/">Command line</a>
				<a href="#variables.basePath#reference/configuration/">Configuration</a>
				<a href="#variables.basePath#licenses/">Licenses</a>
			</div>
			<div class="footer-col">
				<h4>Project</h4>
				<a href="#variables.basePath#roadmap/">Roadmap</a>
				<a href="#variables.basePath#contribute/">Contribute</a>
				<a href="#variables.basePath#troubleshooting/">Troubleshooting</a>
				<a href="#variables.basePath#voices/">Voices</a>
			</div>
			<div class="footer-col">
				<h4>Community</h4>
				<a href="https://www.ortussolutions.com/community/slack" target="_blank" rel="noopener noreferrer">Slack</a>
				<a href="https://community.ortussolutions.com" target="_blank" rel="noopener noreferrer">Forums</a>
				<bx:if len( variables.repoUrl )>
					<a href="#bxsitesUrlAttr( variables.repoUrl )#/issues" target="_blank" rel="noopener noreferrer">Report an issue</a>
				</bx:if>
				<a href="https://www.ortussolutions.com/services" target="_blank" rel="noopener noreferrer">Consulting</a>
			</div>
		</div>
		<div class="bxh-wrap footer-bottom footrow">
			<span>&copy; #year( now() )# Ortus Solutions, Corp</span>
			<div class="footlinks">
				<a class="footverse" href="https://www.bible.com/bible/59/JHN.14.6.ESV" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">&##10084;&##65039;</span> He is the truth and the life</a>
				<a class="poweredby" href="https://boxlang.io" target="_blank" rel="noopener noreferrer">Part of the <b>BoxLang</b> ecosystem</a>
			</div>
		</div>
	</footer>

	<audio id="ax-audio" preload="none"></audio>
	<script src="#themeAssetUrl( 'audio-home.js' )#" defer></script>

	<!--- Extra JS --->
	#renderExtraJs( variables.siteConfig.extraJs ?: [] )#
</body>
</html>
</bx:output>

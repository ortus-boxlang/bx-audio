/**
 * Renders the short clips the documentation plays (docs/assets/audio/*.mp3): one for each example, at 96 kbps so the site stays small.
 * Run it when an example changes, and commit the clips it writes.
 *
 * The speech based examples (12-voiceover and 13-trailer) need the speech engine, which downloads once; pass --voices to render them, and
 * leave them alone otherwise (the clips already in the folder stay).
 *
 * With --voice-samples it also speaks a sample line with every voice the module offers (docs/assets/audio/voices/*.mp3). That downloads each
 * voice (60 to 114 MB), so it is a thing to run now and then, not on every change.
 *
 * Usage:
 *   boxlang tools/generate-doc-audio.bxs [--voices] [--voice-samples] [--only=house,jazz]
 */

root = expandPath( "../" );
options = cliGetArgs().options;
withVoices = options.keyExists( "voices" ) && options.voices != false;
only = options.keyExists( "only" ) ? options.only.listToArray() : [];
target = root & "docs/assets/audio";
directoryCreate( target, true, true );
temp = getTempDirectory() & "/bxaudio-doc-clips-" & createUUID();
directoryCreate( temp, true, true );

cli = new bxModules.bxaudio.cli.Cli( root );

// The loudness the clips and the voice samples are brought to (LUFS), and the pace the voice samples are spoken at (words a minute)
clipLufs = -16;
voiceLufs = -19;
voiceWpm = 150;

// Settings that make each clip about 20 to 30 seconds
clips = [
	{ id : "pop-drive", args : [ "--bars=12" ] },
	{ id : "lofi", args : [ "--bars=8" ] },
	{ id : "house", args : [ "--bars=12" ] },
	{ id : "ambient", args : [ "--bars=6" ] },
	{ id : "techno", args : [ "--bars=12" ] },
	{ id : "synthwave", args : [ "--bars=10" ] },
	{ id : "cinematic", args : [] },
	{ id : "chiptune", args : [ "--track=overworld" ] },
	{ id : "sfx", args : [] },
	{ id : "jazz", args : [ "--choruses=1" ] },
	{ id : "rock", args : [ "--bars=12" ] },
	{ id : "voiceover", args : [], voice : true },
	{ id : "trailer", args : [ "--seconds=15" ], voice : true },
	{ id : "game-audio", args : [] },
	{ id : "sampler", args : [ "--bars=8" ] },
	{ id : "theme", args : [ "--bars=16" ] }
];

for( clip in clips ){
	if( only.len() && !only.contains( clip.id ) ){
		continue;
	}
	if( clip.keyExists( "voice" ) && !withVoices ){
		println( "skipped " & clip.id & " (needs the speech engine, add --voices)" );
		continue;
	}
	wav = temp & "/" & clip.id & ".wav";
	cli.run( [ "render", clip.id, "--out=" & wav ].append( clip.args, true ) );
	audio = audioLoad( wav );
	// Every clip plays at about the same loudness, with room under the ceiling for the MP3 encoder
	audio = audioMaster( audio = audio, target = clipLufs, truePeakDb = -1.5 );
	audioSave( audio, target & "/" & clip.id & ".mp3", 16, 96 );
	println( clip.id & ": " & numberFormat( audio.getDurationSeconds(), "0.0" ) & " s" );
}

// The short jingle for buttons and the player: the same script with --sting
if( !only.len() || only.contains( "theme" ) ){
	overrides = { out : temp & "/sting.wav", sting : true };
	include "../examples/15-theme/theme.bxs";
	sting = audioLoad( temp & "/sting.wav" );
	sting = audioMaster( audio = sting, target = clipLufs, truePeakDb = -1.5 );
	audioSave( sting, target & "/sting.mp3", 16, 96 );
	println( "sting: " & numberFormat( sting.getDurationSeconds(), "0.0" ) & " s" );
}

if( options.keyExists( "voice-samples" ) && options[ "voice-samples" ] != false ){
	directoryCreate( target & "/voices", true, true );
	// The same line for every voice, so they can be compared. Each voice is spoken once to see how fast it is, then again at the speed that
	// gives the same pace, and brought to the same loudness.
	line = "Welcome to BxAudio. This is one of the open license voices that come with BoxLang. It can read your articles, narrate your videos, and caption your podcasts.";
	words = line.listToArray( " " ).len();
	wanted = words * 60 / voiceWpm;
	for( voice in audioVoices( status = "offered" ) ){
		pauses = { sentence : 0.4, clause : 0.15 };
		trial = audioSpeak( text = line, voice = voice.id, speed = 1, pauses = pauses );
		speed = max( 0.8, min( 1.25, round( trial.getDurationSeconds() / wanted * 100 ) / 100 ) );
		sample = abs( speed - 1 ) < 0.03 ? trial : audioSpeak( text = line, voice = voice.id, speed = speed, pauses = pauses );
		sample = audioMaster( audio = sample, target = voiceLufs, truePeakDb = -1.5 );
		audioSave( sample, target & "/voices/" & voice.id & ".mp3", 16, 64 );
		println( voice.id & ": " & numberFormat( sample.getDurationSeconds(), "0.0" ) & " s at speed " & speed );
	}
}
directoryDelete( temp, true );

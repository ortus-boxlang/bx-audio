/**
 * Builds the voice catalog, src/main/resources/voices.json, from the Piper voices published on Hugging Face.
 *
 * Every voice of every language is classified. A voice is offered ("voices") only when its model card states an open license, its
 * language has a phonemizer in the Voices engine, and it has one speaker. The license is read from each voice's own MODEL_CARD, never
 * guessed. Every other voice goes to "excluded" with the reason, so the module can tell users why a voice is not offered.
 * Run it again when you want newer voices, and review the diff.
 *
 * Usage:
 *   boxlang tools/update-voices.bxs [--languages=en_US,en_GB]   (default: every language)
 */

// The languages the Voices engine can phonemize. en_GB needs the en_uk dictionary, which is licensed GPL 3, so it is not offered.
supported = [ "en_US" ];
gplDictionary = [ "en_GB" ];
languages = ( cliGetArgs().options.languages ?: "" ).listToArray();
base = "https://huggingface.co/rhasspy/piper-voices/resolve/main/";

function fetchText( url ){
	var stream = createObject( "java", "java.net.URI" ).create( url ).toURL().openStream();
	try {
		return createObject( "java", "java.lang.String" ).init( stream.readAllBytes(), "UTF-8" );
	} finally {
		stream.close();
	}
}

/**
 * Map the license text of a model card to an identifier we accept, or "" when it is not an open license we accept
 */
function normalizeLicense( text ){
	var t = text.lcase().trim();
	// Non commercial and custom terms are never accepted, whatever else the line says
	if( t.contains( "-nc" ) || t.contains( " nc " ) || t.contains( "non-commercial" ) || t.contains( "noncommercial" ) || t.contains( "blizzard" ) ){
		return "";
	}
	if( t.startsWith( "cc0" ) ){ return "CC0-1.0"; }
	if( t == "public domain" ){ return "Public-Domain"; }
	if( t.contains( "by-sa" ) || t.contains( "attribution-sharealike" ) ){ return t.contains( "4.0" ) ? "CC-BY-SA-4.0" : ""; }
	if( t == "cc by 4.0" || t == "cc-by 4.0" || t == "cc-by-4.0" || t.contains( "licenses/by/4.0" ) || t.contains( "(cc by 4.0)" ) || t.startsWith( "creative commons attribution 4.0" ) ){ return "CC-BY-4.0"; }
	if( t.contains( "licenses/by/3.0" ) ){ return "CC-BY-3.0"; }
	if( t.contains( "apache" ) ){ return "Apache-2.0"; }
	if( t.contains( "unlicense" ) ){ return "Unlicense"; }
	return "";
}

/**
 * What a license means for someone who sells a service built on the voice:
 *   permissive     CC0, public domain, Unlicense, Apache 2.0: use it, nothing to publish
 *   attribution    CC BY: use it, and credit the creator
 *   sharealike     CC BY-SA: use it, credit the creator, and what you share made from it carries the same terms
 *   noncommercial  BY-NC and BY-NC-SA: not for a product you sell
 *   copyleft       GPL and AGPL: not offered, whether the weights count as the program is untested
 *   custom         a license written for one dataset (Blizzard, IITM, Data Baker)
 *   unclear        the card says nothing, or only "See URL", or a form we do not classify
 * The first three are the commercial ones. The text of the card decides for a voice whose license we do not accept.
 */
function usageOf( license, text ){
	if( [ "CC0-1.0", "Public-Domain", "Unlicense", "Apache-2.0" ].contains( license ) ){ return "permissive"; }
	if( [ "CC-BY-4.0", "CC-BY-3.0" ].contains( license ) ){ return "attribution"; }
	if( license == "CC-BY-SA-4.0" ){ return "sharealike"; }
	var t = text.lcase();
	if( t.contains( "agpl" ) || t.reFind( "(^|[^a-z])gpl" ) ){ return "copyleft"; }
	if( t.contains( "-nc" ) || t.contains( " nc " ) || t.contains( "non-commercial" ) || t.contains( "noncommercial" ) ){ return "noncommercial"; }
	if( t.contains( "blizzard" ) || t.contains( "iitm" ) || t.contains( "data-baker" ) ){ return "custom"; }
	return "unclear";
}

/**
 * Say in a few words why a model card's license was not accepted
 */
function reasonFor( text ){
	var t = text.lcase();
	if( !text.len() ){ return "The model card states no license"; }
	if( t.contains( "agpl" ) || t.reFind( "(^|[^a-z])gpl" ) ){ return "Copyleft license (" & text.left( 20 ) & "), not offered"; }
	if( t.contains( "-nc" ) || t.contains( "non-commercial" ) || t.contains( "noncommercial" ) ){ return "Non-commercial license"; }
	if( t.contains( "blizzard" ) ){ return "Custom license (Blizzard 2013 data), not an open license"; }
	if( t.startsWith( "see" ) ){ return "The model card only says '" & text & "', so the license is not clear"; }
	return "Not an open license we accept: " & text.left( 50 );
}

println( "Reading the voice list..." );
all = jsonDeserialize( fetchText( base & "voices.json" ) );
kept = [];
excluded = [];

for( key in all.keyArray().sort( "text" ) ){
	voice = all[ key ];
	if( languages.len() && !languages.contains( voice.language.code ) ){
		continue;
	}
	cardPath = voice.files.keyArray().filter( ( f ) => f.endsWith( "MODEL_CARD" ) );
	card = cardPath.len() ? fetchText( base & cardPath.first() ) : "";
	licenseMatch = card.reFind( "License:[ \t]*([^\r\n]*)", 1, true );
	licenseText = licenseMatch.match.len() > 1 ? licenseMatch.match[ 2 ].trim() : "";
	urlMatch = card.reFind( "URL:[ \t]*(\S+)", 1, true );
	sourceUrl = urlMatch.match.len() > 1 ? urlMatch.match[ 2 ] : "";
	license = normalizeLicense( licenseText );
	kind = "";
	reason = "";
	if( !license.len() ){
		kind = "license";
		reason = reasonFor( licenseText );
	} else if( gplDictionary.contains( voice.language.code ) ){
		kind = "dictionary";
		reason = "Needs the British English dictionary of the Voices engine, which is licensed GPL 3";
	} else if( !supported.contains( voice.language.code ) ){
		kind = "language";
		reason = "Not supported yet: the Voices engine has no phonemizer for " & voice.language.name_english;
	} else if( voice.num_speakers != 1 ){
		kind = "speakers";
		reason = voice.num_speakers & " speakers, not supported yet";
	}
	if( kind.len() ){
		totalSize = 0;
		for( path in voice.files.keyArray() ){
			if( path.endsWith( ".onnx" ) || path.endsWith( ".onnx.json" ) ){
				totalSize += voice.files[ path ].size_bytes;
			}
		}
		excluded.append( {
			"id" : key, "name" : voice.name, "language" : voice.language.code, "quality" : voice.quality, "license" : license,
			"licenseText" : licenseText, "usage" : usageOf( license, licenseText ), "source" : sourceUrl, "reasonKind" : kind, "reason" : reason,
			"size" : totalSize
		} );
		continue;
	}
	files = {};
	for( path in voice.files.keyArray() ){
		if( path.endsWith( ".onnx" ) ){
			files[ "model" ] = { path : path, size : voice.files[ path ].size_bytes, md5 : voice.files[ path ].md5_digest };
		} else if( path.endsWith( ".onnx.json" ) ){
			files[ "config" ] = { path : path, size : voice.files[ path ].size_bytes, md5 : voice.files[ path ].md5_digest };
		}
	}
	kept.append( {
		"id" : key,
		"name" : voice.name,
		"language" : voice.language.code,
		"quality" : voice.quality,
		"license" : license,
		"licenseText" : licenseText,
		"usage" : usageOf( license, licenseText ),
		"shareAlike" : license.contains( "-SA-" ),
		"source" : sourceUrl,
		"model" : files.model,
		"config" : files.config
	} );
}

output = { "source" : base, "supportedLanguages" : supported, "voices" : kept, "excluded" : excluded };
target = expandPath( "../src/main/resources/voices.json" );
fileWrite( target, jsonPrettify( jsonSerialize( output ) ) );
println( "Wrote " & kept.len() & " voices to " & target );
println( "" );
println( "Left out (" & excluded.len() & "):" );
excluded.each( ( e ) => println( "  " & e.id & "  (" & e.reason & ")" ) );

// The same list as a page for the docs
function mb( bytes ){
	return numberFormat( bytes / 1000000, "0" ) & " MB";
}
doc = [];
doc.append( "---" );
doc.append( "title: Voices" );
doc.append( "order: 1" );
doc.append( "summary: Every voice of the Piper collection: which can be used, which cannot, and why." );
doc.append( "---" );
doc.append( "" );
doc.append( "<!-- Generated by tools/update-voices.bxs. Do not edit. -->" );
doc.append( "" );
doc.append( "These are the voices `audioSpeak()` can use. They are [Piper](https://github.com/rhasspy/piper) voices from the [rhasspy/piper-voices](https://huggingface.co/rhasspy/piper-voices) collection, and none of them is bundled with the module: each is downloaded the first time you use it, into `~/.bxaudio/voices` (see [Storage](guides/storage.md))." );
doc.append( "" );
doc.append( "```bash" );
doc.append( "bx-audio voices                       ## the voices you can use, from the command line" );
doc.append( "bx-audio voices --excluded            ## the voices that are not offered, and why" );
doc.append( "bx-audio voices joe                   ## one voice in detail" );
doc.append( "bx-audio install joe                  ## download a voice ahead of time" );
doc.append( "bx-audio speak ""Hello"" --voice=joe     ## or just use it, it installs itself" );
doc.append( "```" );
doc.append( "" );
doc.append( "```js" );
doc.append( "audio = audioSpeak( text=""Hello from BoxLang"", voice=""joe"" );" );
doc.append( "audioSave( audio, ""hello.mp3"" );" );
doc.append( "```" );
doc.append( "" );
doc.append( "#### Licenses" );
doc.append( "" );
doc.append( "Only voices whose model card states an open license are listed: CC0, public domain, CC BY, CC BY-SA, Apache 2.0 or the Unlicense. The license column is the identifier we map the card's wording to, and the card itself stays the authority, so read it when it matters (the link in the last column leads to the training data). Voices whose card says non-commercial, names a custom license, says only ""See URL"", or says nothing are not listed. The usage column says what the license means for a product you sell, see [Using voices in a product you sell](##using-voices-in-a-product-you-sell)." );
doc.append( "" );
doc.append( "#### Available voices" );
doc.append( "" );
doc.append( "| Voice | Language | Quality | License | Usage | Download | Training data | Listen |" );
doc.append( "|---|---|---|---|---|---|---|---|" );
for( v in kept ){
	// A sample line spoken by the voice, made by tools/generate-doc-audio.bxs --voice-samples
	sample = fileExists( expandPath( "../docs/assets/audio/voices/" & v.id & ".mp3" ) ) ? "<audio controls preload=""none"" src=""assets/audio/voices/" & v.id & ".mp3""></audio>" : "";
	doc.append( "| `" & v.id & "` | " & v.language & " | " & v.quality & " | " & v.license & " | " & v.usage & " | " & mb( v.model.size + v.config.size ) & " | " & ( v.source.len() ? "[source](" & v.source & ")" : "not stated" ) & " | " & sample & " |" );
}
doc.append( "" );
doc.append( "Use a voice by its full id, or by its short name when only one voice has that name (`joe`, but not `ljspeech`, which comes in two qualities)." );
doc.append( "" );
doc.append( "#### Using voices in a product you sell" );
doc.append( "" );
doc.append( "Every offered license allows commercial use, so you can sell a service that speaks with these voices as long as you do what the license asks. Each voice has a `usage`:" );
doc.append( "" );
doc.append( "| Usage | Licenses | What you do |" );
doc.append( "|---|---|---|" );
doc.append( "| `permissive` | CC0, public domain, Unlicense, Apache 2.0 | Nothing is required. With Apache 2.0, keep the license notice. |" );
doc.append( "| `attribution` | CC BY | Credit the creator of the training data and link the license. For model training, Creative Commons says the credit can be a link to the source of the dataset. |" );
doc.append( "| `sharealike` | CC BY-SA | Credit as above. The license also asks that adapted material you share carries the same terms. Whether speech made by a model is adapted material is not settled, so read the card, and take advice if you need to be sure. |" );
doc.append( "" );
doc.append( "`audioCredits( [ ""joe"", ""en_US-sam-medium"" ] )` or `bx-audio credits joe sam` writes the credits for the voices you use, ready to paste into an about page. Filter the list with `audioVoices( usage=""permissive,attribution"" )` or `bx-audio voices --usage=permissive,attribution`." );
doc.append( "" );
doc.append( "These licenses were written for datasets and software, not for speech made by a model, so a few questions have no settled answer. This page is a guide, not legal advice. The code of this module is Apache 2.0, and the MP3 libraries are LGPL jars that you download separately." );
doc.append( "" );
doc.append( "#### Not offered" );
doc.append( "" );
doc.append( "Every voice of the collection that is not offered, and why. `bx-audio voices --excluded` prints the same list, and `audioVoices( status=""excluded"" )` returns it. The usage column describes the license, whether the voice is offered is a separate question." );
doc.append( "" );
doc.append( "| Why | Voices |" );
doc.append( "|---|---|" );
for( kindName in [ "license", "dictionary", "speakers", "language" ] ){
	count = excluded.filter( ( e ) => e.reasonKind == kindName ).len();
	label = { license : "License is not open or not clear", dictionary : "Needs the GPL 3 British dictionary", speakers : "Several speakers", language : "Language not supported yet" }[ kindName ];
	doc.append( "| " & label & " | " & count & " |" );
}
doc.append( "" );
doc.append( "The voices left out for their license, by what the license is:" );
doc.append( "" );
doc.append( "| Usage | Meaning | Voices |" );
doc.append( "|---|---|---|" );
for( usageName in [ "noncommercial", "copyleft", "custom", "unclear" ] ){
	count = excluded.filter( ( e ) => e.reasonKind == "license" && e.usage == usageName ).len();
	meaning = {
		noncommercial : "BY-NC and BY-NC-SA: not for a product you sell",
		copyleft : "GPL and AGPL: whether model weights count as the program is untested",
		custom : "A license written for one dataset",
		unclear : "The card says nothing, only ""See URL"", or a form we do not classify"
	}[ usageName ];
	doc.append( "| `" & usageName & "` | " & meaning & " | " & count & " |" );
}
doc.append( "" );
doc.append( "| Voice | Language | License on the card | Usage | Why |" );
doc.append( "|---|---|---|---|---|" );
for( e in excluded ){
	doc.append( "| `" & e.id & "` | " & e.language & " | " & ( e.licenseText.len() ? e.licenseText.replace( "|", "/", "all" ) : "none" ) & " | " & e.usage & " | " & e.reason.replace( "|", "/", "all" ) & " |" );
}
doc.append( "" );
doc.append( "British English voices (`en_GB`) need the `en_uk` dictionary of the Voices engine, which is licensed GPL 3, so they are not offered. Other languages need a phonemizer the engine does not have yet." );
doc.append( "" );
doc.append( "#### Updating this list" );
doc.append( "" );
doc.append( "This page and `voices.json` are generated. Run `boxlang tools/update-voices.bxs` in the module repository to read the current voices and their model cards again, and review the difference." );
newline = createObject( "java", "java.lang.System" ).lineSeparator();
fileWrite( expandPath( "../docs/voices.md" ), doc.toList( newline ) & newline );
println( "Wrote the docs page docs/voices.md" );
